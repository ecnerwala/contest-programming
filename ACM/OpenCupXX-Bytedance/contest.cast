[14808.468516, "o", "          \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m179 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mndp.nonChainWays[\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m][\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m] += dp[p].chainWays[!z] * dp[i].chainWays[z] * -A[i][z];                                  \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m180 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}                                                                                                                   \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m181 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                    \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m182 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mdp[p] = ndp;                                                                                                        \r\n\u001b(B\u001b[0;1m\u001b[97m\u001b[106m COMMAND \u001b(B\u001b[m\u001b[96m\u001b[103m\u001b(B\u001b[m\u001b[37m\u001b[103m +0 ~0 -0  masterɆ \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[92m\u001b[40m  2:modnum.hpp  \u001b(B\u001b[0;1m\u001b[94m\u001b[100m 1:K.cpp  \u001b(B\u001b[m\u001b[92m\u001b[40m "]
