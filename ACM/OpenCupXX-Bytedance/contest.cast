[2680.73896, "o", "\u001b[?25l\u001b[28;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b[29;5H»   \u001b(B\u001b[m\u001b[94m\u001b[100m};\u001b[30;5H\u001b[21X\u001b[31;9H\u001b(B\u001b[m\u001b[92m\u001b[100m// swap i-1 and i\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[10X\u001b[32;9H\u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m do_swap = [&](\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i) {\u001b[33;13Hswap(A[i-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m], A[i])\u001b[34;21H-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m]] = i-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[35;13HinvA[A[i]] = i;   \u001b[36;26H-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m]);\u001b[37;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mupdateVal(A[i]);\u001b[38;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m};\u001b[39;5H\u001b[47X\u001b[40;9H\u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m query_mex = [&](\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m j) -> \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m {\u001b[41;13H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (!(i <= invA[\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m] && invA[\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m] <= j)) {\u001b[42;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b"]
[2680.739002, "o", "[m\u001b[94m\u001b[100m;\u001b[43;13H}\u001b[15X\u001b[44;9H\u001b(B\u001b[m\u001b[4:3m\u001b[58:2::255:0:0m\u001b[94m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m cur = )\u001b[45;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m};\u001b[46;5H\u001b[11X\u001b[47;9Hinit();\u001b[10X\u001b[48;9Hstd::mt19937 gen;\u001b[49;9Hgen.seed(seed);\u001b[50;9H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m last = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[51;9H\u001b(B\u001b[m\u001b[32m\u001b[100mwhile\u001b(B\u001b[m\u001b[94m\u001b[100m (Q--) {\u001b[10X\u001b[52;17Hop = gen() % K;\u001b[8X\u001b[53;13H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = (gen() + last) % N;\u001b[54;13H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (!op && i) {\u001b[55;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mdo_swap(i);\u001b[56;13H} \u001b(B\u001b[m\u001b[32m\u001b[100melse\u001b(B\u001b[m\u001b[94m\u001b[100m {\u001b[14X\u001b[57;17H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m j = gen() % N;\u001b[32X\u001b[58;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mlast ^= query_mex(std::min(i, j), std::max(i, j));\u001b[59;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[60;9H}\u001b[20X\u001b[61;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcout << last << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B"]
