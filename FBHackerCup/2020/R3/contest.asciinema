[1927.206553, "o", "\u001b[?25l\u001b(B\u001b[m\u001b[34m\u001b[100mCXX \u001b(B\u001b[m\u001b[94m\u001b[100m= g++\u001b[2;5H\u001b(B\u001b[m\u001b[34m\u001b[100mCXXFLAGS \u001b(B\u001b[m\u001b[94m\u001b[100m= -std=c++17 -O2 -Wall -Wextra -pedantic -Wshadow -Wformat=2 -Wfloat-equal -Wconversion -Wlogical-op -Wshift-overflow=2 -Wd\u001b(B\u001b[m\u001b[92m\u001b[40m    \u001b(B\u001b[m\u001b[94m\u001b[100muplicated-cond -Wcast-qual -Wcast-align -Wno-unused-result -Wno-sign-conversion\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m  3 \u001b(B\u001b[m\u001b[34m\u001b[100mDEBUGFLAGS \u001b(B\u001b[m\u001b[94m\u001b[100m= -D_GLIBCXX_DEBUG -D_GLIBCXX_DEBUG_PEDANTIC -fsanitize=address -fsanitize=undefined -fsanitize=float-divide-by-zero -fsa\u001b(B\u001b[m\u001b[92m\u001b[40m    \u001b(B\u001b[m\u001b[94m\u001b[100mnitize=float-cast-overflow -fno-sanitize-recover=all -fstack-protector-all -D_FORTIFY_SOURCE=2\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m  4 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m  5 \u001b(B\u001b[m\u001b[34m\u001b[100mDEBUG \u001b(B\u001b[m\u001b[94m\u001b[100m= true\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m  6 \u001b(B\u001b[m\u001b[91m\u001b[100mifeq\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[34m\u001b[100m$(DEBUG)\u001b(B\u001b[m\u001b[94m\u001b[100m,true)\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m  7 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mCXXFLAGS += \u001b(B\u001b[m\u001b[34m\u001b[100m$(DEBUGFLAGS)\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m"]
