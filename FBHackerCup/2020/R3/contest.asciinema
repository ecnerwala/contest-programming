[9172.032027, "o", "\u001b(B\u001b[m\u001b[94m\u001b[100m l1 = min(c, x);\u001b[7X\u001b[57;34H2 = min(c, y\u001b[58;29H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (l1 + l2 < N) \u001b(B\u001b[m\u001b[32m\u001b[100mcontinue\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[59;5H\u001b[50X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m num_cuts = (N - final_C > l1 || final_C > l2);\u001b[61;29H\u001b(B\u001b[m\u001b[92m\u001b[100m// number of ways for Q\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[27X\u001b[62;29Hcerr << \u001b(B\u001b[m\u001b[36m\u001b[100m\"F(\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m\"2+\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << c << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << x << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << y << \u001b(B\u001b[m\u001b[36m\u001b[100m\") = \"\u001b(B\u001b[m\u001b[94m\u001b[100m << N - num_cuts << \u001b(B\u001b[m\u001b[36m\u001b[100m\" x \"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m(N-\u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m+ \u001b(B\u001b[m\u001b[92m\u001b[40m    \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m) << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[120X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m109 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mans[N - num_cuts] += \u001b(B\u001b[m\u001b[33m"]
