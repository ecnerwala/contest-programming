[7959.331065, "o", "\u001b[?25l\u001b[8D\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m x = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; x <= N; x++) {\u001b[35;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m y = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; y <= N; y++) {\u001b[36;25H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (x < N-c && y < N-c) { \u001b[37;29H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mcontinue\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[12X\u001b[38;29H}\u001b[12X\u001b[39;25H}    \u001b[40;21H}    \u001b[41;17H}    \u001b[42;13H}    \u001b[43;13H{ \u001b(B\u001b[m\u001b[92m\u001b[100m// Q >= 2: no problems, you can get any 2 chains; only issue is final configuration\u001b[44;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m c = init_C; c <= N; c++) {\u001b[46X\u001b[45;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m x = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; x <= N; x++) { \u001b[46;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b"]
