[9004.725341, "o", "\u001b[?25l\u001b[28;29H\u001b[77X\ncerr << \u001b(B\u001b[m\u001b[36m\u001b[100m\"F(\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << c << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << x << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << y << \u001b(B\u001b[m\u001b[36m\u001b[100m\") = \"\u001b(B\u001b[m\u001b[94m\u001b[100m << v << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[30;25H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mans[v]++;\u001b[31;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[32;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[33;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[34;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[35;5H\u001b[93X\u001b[36;13H{ \u001b(B\u001b[m\u001b[92m\u001b[100m// Q >= 2: no problems, you can get any 2 chains; only issue is final configuration\u001b[37;17H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m c = init_C; c <= N; c++) {\u001b[38;21H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m x = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; x <= N; x++) {    \u001b[39;25H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m"]
[9004.725497, "o", " (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m y = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; y <= N; y++) {\u001b[40;34H1 = min(c, x\u001b[41;29H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m l2 = min(c, y);\u001b[7X\u001b[42;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (l1 + l2 < N) \u001b(B\u001b[m\u001b[32m\u001b[100mcontinue\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[43;5H\u001b[74X\u001b[44;29H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m num_cuts = (N - final_C > l1 || final_C > l2);\u001b[45;29H\u001b(B\u001b[m\u001b[92m\u001b[100m// number of ways for Q\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[84X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m115 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcerr << \u001b(B\u001b[m\u001b[36m\u001b[100m\"F(\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m\"2+\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << c << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << x << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << y << \u001b(B\u001b[m\u001b[36m\u001b[100m\") = \"\u001b(B\u001b[m\u001b[94m\u001b[100m << N - num_cuts << \u001b(B\u001b[m\u001b[36m\u001b[100m\" x \"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m(N-\u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m+ \u001b(B\u001b[m\u001b[92m\u001b[40m"]
