[9169.284692, "o", "\u001b[?25l\u001b[34;25H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b[35;21H»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[36;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[37;5H\u001b[47X\u001b[38;21H\u001b(B\u001b[m\u001b[92m\u001b[100m// num_good is the optimal case\u001b[39;21H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m x = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; x <= N; x++) {    \u001b[40;25H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m y = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; y <= N; y++) {\u001b[41;34H1 = min(c, x\u001b[42;29H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m l2 = min(c, y);\u001b[7X\u001b[43;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (l1 + l2 < N) \u001b(B\u001b[m\u001b[32m\u001b[100mcontinue\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[44;5H\u001b[66X\u001b[45;29H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m v = num_good - (x < l[\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m] || y < l[\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m]);\u001b[35X\u001b[46;29Hcerr << \u001b(B\u001b[m\u001b[36m\u001b[100m\"F(\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[10"]
[9169.284883, "o", "0m << c << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << x << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << y << \u001b(B\u001b[m\u001b[36m\u001b[100m\") = \"\u001b(B\u001b[m\u001b[94m\u001b[100m << v << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[47;25H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mans[v]++;\u001b[48;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[49;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[50;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[51;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[52;5H\u001b[93X\u001b[53;13H{ \u001b(B\u001b[m\u001b[92m\u001b[100m// Q >= 2: no problems, you can get any 2 chains; only issue is final configuration\u001b[54;17H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m c = init_C; c <= N; c++) {\u001b[55;21H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m x = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; x <= N; x++) {    \u001b[56;25H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m y = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; y <= N; y++) {\u001b[57;34H1 = min(c, x\u001b[58;29H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b"]
