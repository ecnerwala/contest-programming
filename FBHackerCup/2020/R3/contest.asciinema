[8751.447683, "o", "\u001b[?25l\u001b[37A\u001b[85X\n{ \u001b(B\u001b[m\u001b[92m\u001b[100m// Q >= 2: no problems, you can get any 2 chains; only issue is final configuration\u001b[34;17H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m c = init_C; c <= N; c++) {\u001b[35;21H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m x = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; x <= N; x++) {    \u001b[36;25H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m y = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; y <= N; y++) {\u001b[37;29H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (x + y < N) \u001b(B\u001b[m\u001b[32m\u001b[100mcontinue\u001b(B\u001b[m\u001b[94m\u001b[100m;   \u001b[38;34H1 = min(c, min\u001b[39;33Hl2 = min(c, max(x, y));\u001b[40;29H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m num_cuts = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[16X\u001b[41;33HN - final_C > l1) num_cuts++;\u001b[42;29H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (final_C > l2) {\u001b[43;33Hnum_cuts++;\u001b[22X\u001b[44;29H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (final_C - l2 > c) num_cuts++;\u001b[45;29H}\u001b[22X\u001b[46;29H\u001b(B\u001b[m\u001b[92m\u001b"]
[8751.447842, "o", "[100m// number of ways for Q\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[84X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m116 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcerr << \u001b(B\u001b[m\u001b[36m\u001b[100m\"F(\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m\"2+\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << c << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << x << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << y << \u001b(B\u001b[m\u001b[36m\u001b[100m\") = \"\u001b(B\u001b[m\u001b[94m\u001b[100m << N - num_cuts << \u001b(B\u001b[m\u001b[36m\u001b[100m\" x \"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m(N-\u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m+ \u001b(B\u001b[m\u001b[92m\u001b[40m    \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m) << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[53X\u001b[49;25H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mans[N - num_cuts] += \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m(N - \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m + \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[50;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[51;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[52;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[53;5H\u001b(B\u001b[0;1m\u001b[30m\u001b"]
