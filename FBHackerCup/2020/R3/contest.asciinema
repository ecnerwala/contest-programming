[9154.371763, "o", "B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << c << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << x << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << y << \u001b(B\u001b[m\u001b[36m\u001b[100m\") = \"\u001b(B\u001b[m\u001b[94m\u001b[100m << v << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[44;29Hans[v]++;\u001b[68X\u001b[45;25H}\u001b[12X\u001b[46;21H}    \u001b[47;17H}    \u001b[48;13H}    \u001b[49;5H\u001b[9X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100m{ \u001b(B\u001b[m\u001b[92m\u001b[100m// Q >= 2: no problems, you can get any 2 chains; only issue is final configuration\u001b[51;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m c = init_C; c <= N; c++) {\u001b[46X\u001b[52;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m x = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; x <= N; x++) { \u001b[53;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m y = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; y <= N; y++) {\u001b[54;25H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m "]
[9154.371855, "o", "l1 = min(c, x);\u001b[7X\u001b[55;34H2 = min(c, y\u001b[56;29H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (l1 + l2 < N) \u001b(B\u001b[m\u001b[32m\u001b[100mcontinue\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[57;5H\u001b[50X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m num_cuts = (N - final_C > l1 || final_C > l2);\u001b[59;29H\u001b(B\u001b[m\u001b[92m\u001b[100m// number of ways for Q\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[27X\u001b[60;29Hcerr << \u001b(B\u001b[m\u001b[36m\u001b[100m\"F(\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m\"2+\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << c << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << x << \u001b(B\u001b[m\u001b[36m\u001b[100m','\u001b(B\u001b[m\u001b[94m\u001b[100m << y << \u001b(B\u001b[m\u001b[36m\u001b[100m\") = \"\u001b(B\u001b[m\u001b[94m\u001b[100m << N - num_cuts << \u001b(B\u001b[m\u001b[36m\u001b[100m\" x \"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m(N-\u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m+ \u001b(B\u001b[m\u001b[92m\u001b[40m    \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m) << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[120X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m107 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mans[N - num_cuts] += \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b["]
