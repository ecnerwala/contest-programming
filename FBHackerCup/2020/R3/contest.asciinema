[1758.012076, "o", "»   »   \u001b(B\u001b[m\u001b[94m\u001b[100massert(D1 >= D2);\u001b[41;5H\u001b[41X\u001b[42;17HN = \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m + (\u001b(B\u001b[m\u001b[4:3m\u001b[58:2::255:0:0m\u001b[94m\u001b[100mD1\u001b(B\u001b[m\u001b[94m\u001b[100m-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m) + (D2-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m) - K3;\u001b[43;13H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m M = \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m + (D1-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m) + (D2-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[44;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100massert(N <= \u001b(B\u001b[m\u001b[36m\u001b[100m2000\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[45;5H\u001b[51X\u001b[46;13Hvector<pair<\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m>> ops; ops.reserve(M);\u001b[47;13Hops.emplace_back(\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m, \u001b(B\u001b[m\u001b[4:3m\u001b[58:2::255:0:0m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[4:3m\u001b[58:2::255:0:0m\u001b[94m\u001b[100m)\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[9X\u001b[48;13H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; i < D1-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; i++) {\u001b[49;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[1"]
