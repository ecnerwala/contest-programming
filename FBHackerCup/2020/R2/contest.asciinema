[2676.529304, "o", "ht -= (*extra_weights.rbegin()).first;                                                                          \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m177 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                    \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m178 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mans *= mnum(tot_weight);                                                                                                \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m179 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}                                                                                                                           \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m180 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                    \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m181 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcout << \u001b(B\u001b[m\u001b[36m\u001b[100m\"Case #\"\u001b(B\u001b[m\u001b[94m\u001b[100m << case_num << \u001b(B\u001b[m\u001b[36m\u001b[100m\": \"\u001b(B\u001b[m\u001b[94m\u001b[100m << ans <<"]
[2676.529473, "o", " \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;                                                                        \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m182 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}                                                                                                                               \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m183 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                    \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m184 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;                                                                                                                       \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m185 \u001b(B\u001b[m\u001b[94m\u001b[100m}                                                                                                                                   \r\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m~                                                                                                                "]
[2676.530282, "o", "                       \r\n\u001b(B\u001b[0;1m\u001b[97m\u001b[106m COMMAND \u001b(B\u001b[m\u001b[96m\u001b[103m\u001b(B\u001b[m\u001b[37m\u001b[103m +0 ~0 -0  masterɆ \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[92m\u001b[40m  2:A.cpp   3:modnum.hpp  \u001b(B\u001b[0;1m\u001b[94m\u001b[100m 1:C.cpp  \u001b(B\u001b[m\u001b[92m\u001b[40m          \u001b(B\u001b[m\u001b[30m\u001b[40m\u001b(B\u001b[m\u001b[92m\u001b[40m cpp \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[37m\u001b[103m utf-8[unix] \u001b(B\u001b[m\u001b[96m\u001b[103m\u001b(B\u001b[m\u001b[97m\u001b[106m 96% \u001b(B\u001b[0;1m\u001b[97m\u001b[106m☰ 178/185 \u001b(B\u001b[m\u001b[97m\u001b[106m:13 \u001b(B\u001b[m\u001b[91m\u001b[106m\u001b(B\u001b[m\u001b[97m\u001b[101m ☲ [123]trailing \u001b(B\u001b[m\u001b[94m\u001b[100m\r\n\u001b[J\u001b[68;2H\u001b(B\u001b[0;1m\u001b[97m\u001b[106mNORMAL \u001b(B\u001b[m\u001b[96m\u001b[103m\u001b(B\u001b[m\u001b[37m\u001b[103m  masterɆ \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[92m\u001b[40m  2:A.cpp   3:modnum.hpp  \u001b(B\u001b[0;1m\u001b[94m\u001b[100m 1:C.cpp  \u001b(B\u001b[m\u001b[92m\u001b[40m          \u001b[59;17H\u001b[?25h"]
[2676.58762, "o", "\u001b[?25l\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[H\u001b[2J\u001b(B\u001b[m\u001b[92m\u001b[40m120 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// MST means removing N+1 edges\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m121 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// We remove >= 1 from each small circle, which is >= N total\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m122 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// And the last is either a 2nd from a small circle or 1 from the big circle\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m123 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m124 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m E = N * M + N;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m125 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100mvector<\u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m> W(E, \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m);\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m126 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m tot_weight = std::accumulate(W.begin(), W.end(), \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m(\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m));\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m127 \r\n128 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100mvector"]
