[3720.181107, "o", "\u001b[?25l\r\u001b[3;1H\u001b(B\u001b[0;1;4m\u001b[94m\u001b[40m  3 +-- 81 lines: template <int MOD_> struct modnum {···················································································\u001b[4;2H\u001b(B\u001b[m\u001b[92m\u001b[40m84 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[36X\u001b[5;2H\u001b(B\u001b[m\u001b[92m\u001b[40m85 \u001b(B\u001b[m\u001b[33m\u001b[100mnamespace\u001b(B\u001b[m\u001b[94m\u001b[100m kactl {\u001b[35X\u001b[6;2H\u001b(B\u001b[m\u001b[92m\u001b[40m86 \u001b(B\u001b[m\u001b[32m\u001b[100musing\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[33m\u001b[100mnamespace\u001b(B\u001b[m\u001b[94m\u001b[100m std;\u001b[7;2H\u001b(B\u001b[m\u001b[92m\u001b[40m87 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[8X\u001b[8;2H\u001b(B\u001b[m\u001b[92m\u001b[40m88 \u001b(B\u001b[m\u001b[91m\u001b[100m#define rep(i, a, b) \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[91m\u001b[100m(\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[91m\u001b[100m i = a; i < (b); ++i)\u001b[9;2H\u001b(B\u001b[m\u001b[92m\u001b[40m89 \u001b(B\u001b[m\u001b[91m\u001b[100m#define all(x) begin(x), end(x)\u001b[10;2H\u001b(B\u001b[m\u001b[92m\u001b[40m90 \u001b(B\u001b[m\u001b[91m\u001b[100m#define sz(x) (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[91m\u001b[100m)(x).size()\u001b[11;2H\u001b(B\u001b[m\u001b[92m\u001b[40m91 \u001b(B\u001b[m\u001b[33m\u001b[100mtypedef\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[33m\u001b[100mlong\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[33m\u001b[100mlong\u001b(B\u001b[m\u001b[94m\u001b[100m "]
[3720.181246, "o", "ll;\u001b[12;2H\u001b(B\u001b[m\u001b[92m\u001b[40m92 \u001b(B\u001b[m\u001b[33m\u001b[100mtypedef\u001b(B\u001b[m\u001b[94m\u001b[100m pair<\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m> pii;\u001b[8X\u001b[13;2H\u001b(B\u001b[m\u001b[92m\u001b[40m93 \u001b(B\u001b[m\u001b[33m\u001b[100mtypedef\u001b(B\u001b[m\u001b[94m\u001b[100m vector<\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m> vi;\u001b[14;2H\u001b(B\u001b[m\u001b[92m\u001b[40m94 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[18X\u001b[15;2H\u001b(B\u001b[m\u001b[92m\u001b[40m95 \u001b(B\u001b[m\u001b[92m\u001b[100m// https://github.com/kth-competitive-programming/kactl/blob/master/content/data-structures/LineContainer.h\u001b[16;2H\u001b(B\u001b[m\u001b[92m\u001b[40m96 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[5X\u001b[17;2H\u001b(B\u001b[m\u001b[92m\u001b[40m97 \u001b(B\u001b[m\u001b[92m\u001b[100m/**\u001b[18;2H\u001b(B\u001b[m\u001b[92m\u001b[40m98 \u001b(B\u001b[m\u001b[92m\u001b[100m * Author: Simon Lindholm\u001b[19;2H\u001b(B\u001b[m\u001b[92m\u001b[40m99 \u001b(B\u001b[m\u001b[92m\u001b[100m * Date: 2017-04-20\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m100 \u001b(B\u001b[m\u001b[92m\u001b[100m * License: CC0\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[7X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m101 \u001b(B\u001b[m\u001b[92m\u001b[100m * Source: own work\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[42X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m102 \u001b(B\u001b[m\u001b[92m\u001b[100m * Description: Container where you can add lines of the form kx+m, and query maximum values at points x.\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m103 \u001b(B"]
[3720.181309, "o", "\u001b[m\u001b[92m\u001b[100m *  Useful for dynamic programming (``convex hull trick'').\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[40X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m104 \u001b(B\u001b[m\u001b[92m\u001b[100m * Time: O(\\log N)\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[96X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m105 \u001b(B\u001b[m\u001b[92m\u001b[100m * Status: stress-tested\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m106 \u001b(B\u001b[m\u001b[92m\u001b[100m */\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[82X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m107 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[85X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m108 \u001b(B\u001b[m\u001b[33m\u001b[100mstruct\u001b(B\u001b[m\u001b[94m\u001b[100m Line {\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m109 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[33m\u001b[100mmutable\u001b(B\u001b[m\u001b[94m\u001b[100m ll k, m, p; \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m110 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[33m\u001b[100mbool\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[32m\u001b[100moperator\u001b(B\u001b[m\u001b[94m\u001b[100m<(\u001b(B\u001b[m\u001b[33m\u001b[100mconst\u001b(B\u001b[m\u001b[94m\u001b[100m Line& o) \u001b(B\u001b[m\u001b[33m\u001b[100mconst\u001b(B\u001b[m\u001b[94m\u001b[100m { \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m k < o.k; }\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m111 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[33m\u001b[100mbool\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[32m\u001b[100moperator\u001b(B\u001b[m\u001b[94m\u001b[100m<(ll x) \u001b(B\u001b[m\u001b[33m\u001b[100mconst\u001b(B\u001b[m\u001b[94m\u001b[100m { \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m p < x; }\r\n\u001b(B\u001b[m\u001b["]
[3720.181368, "o", "92m\u001b[40m112 \u001b(B\u001b[m\u001b[94m\u001b[100m};\u001b[17X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m113 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[5X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m114 \u001b(B\u001b[m\u001b[33m\u001b[100mstruct\u001b(B\u001b[m\u001b[94m\u001b[100m LineContainer : multiset<Line, less<>> {\u001b[11X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m115 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// (for doubles, use inf = 1/.0, div(a,b) = a/b)\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m116 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[33m\u001b[100mconst\u001b(B\u001b[m\u001b[94m\u001b[100m ll inf = \u001b(B\u001b[m\u001b[36m\u001b[100mLLONG_MAX\u001b(B\u001b[m\u001b[94m\u001b[100m;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m117 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mll div(ll a, ll b) { \u001b(B\u001b[m\u001b[92m\u001b[100m// floored division\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m118 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m a / b - ((a ^ b) < \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m && a % b); }\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m119 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[33m\u001b[100mbool\u001b(B\u001b[m\u001b[94m\u001b[100m isect(iterator x, iterator y) {\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m120 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (y == end()) { x->p = inf; \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[36m\u001b[100mfalse\u001b(B\u001b[m\u001b["]
[3720.181443, "o", "94m\u001b[100m; }\u001b[5X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m121 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (x->k == y->k) x->p = x->m > y->m ? inf : -inf;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m122 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[32m\u001b[100melse\u001b(B\u001b[m\u001b[94m\u001b[100m x->p = div(y->m - x->m, x->k - y->k);\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m123 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m x->p >= y->p;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m12\r\n125 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[33m\u001b[100mvoid\u001b(B\u001b[m\u001b[94m\u001b[100m add(ll k, ll m) {\u001b[5X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m126 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m z = insert({k, m, \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m}), y = z++, x = y;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m127 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[32m\u001b[100mwhile\u001b(B\u001b[m\u001b[94m\u001b[100m (isect(y, z)) z = erase(z);\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m128 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (x != begin() && isect(--x, y)) isect(x, y = erase(y));\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m129 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[32m\u001b[100mwhile\u001b(B\u001b[m\u001b[94m\u001b[100m ((y = x) "]
