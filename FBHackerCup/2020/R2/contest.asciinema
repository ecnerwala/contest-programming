[2580.306778, "o", "\u001b[?25l\u001b[H\u001b(B\u001b[m\u001b[92m\u001b[40m120 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// MST means removing N+1 edges\u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                             \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m121 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// We remove >= 1 from each small circle, which is >= N total\u001b(B\u001b[m\u001b[94m\u001b[100m                                                               \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m122 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// And the last is either a 2nd from a small circle or 1 from the big circle\u001b(B\u001b[m\u001b[94m\u001b[100m                                                \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m123 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                            \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m124 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m E = N * M + N;                                                                                          "]
[2580.306969, "o", "                \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m125 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100mvector<\u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m> W(E, \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m);                                                                                                    \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m126 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m tot_weight = std::accumulate(W.\u001b(B\u001b[0;7m\u001b[33m\u001b[100mbegin\u001b(B\u001b[m\u001b[94m\u001b[100m(), W.end(), \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m(\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m));                                                       \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m127 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                    \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m128 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100mvector<array<set<pair<\u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m>>, \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m>> circle_weights(N);                              "]
[2580.307071, "o", "                                  \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m129 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100mset<pair<\u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m>> extra_weights;                                                                                      \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m130 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100mvector<set<pair<\u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m>>*> controller(E);                                                                             \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m131 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m e = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; e < E; e++) {                                                                                               \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m132 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (e < N * M) {                                                                                   "]
[2580.307142, "o", "                     \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m133 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = e / M;                                                                                                      \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m134 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m j = e % M;                                                                                                      \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m135 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcontroller[e] = &circle_weights[i][X[i] <= j && j < Y[i]];                                                          \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m136 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m} \u001b(B\u001b[m\u001b[32m\u001b[100melse\u001b(B\u001b[m\u001b[94m\u001b[100m {                                                                                                                \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m137 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcontroller[e] = &extra_weights;                                              "]
