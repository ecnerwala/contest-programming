[2492.253194, "o", "                            \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m138 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m} \u001b(B\u001b[m\u001b[32m\u001b[100melse\u001b(B\u001b[m\u001b[94m\u001b[100m {                                                                                                                \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m139 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcontroller[e] = &extra_weights;                                                                                     \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m140 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}                                                                                                                       \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m141 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcontroller[e]->insert({W[e], e});                                                                                       \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m142 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}                                                                                                                   "]
