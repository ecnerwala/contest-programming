[5356.097756, "o", "\u001b[?25l\u001b[H\u001b(B\u001b[m\u001b[92m\u001b[40m115 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m116 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m117 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m QI = read_vec(Q, N*M+N);\u001b[42X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m118 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m QW = read_vec(Q, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(\u001b(B\u001b[m\u001b[36m\u001b[100m1e9\u001b(B\u001b[m\u001b[94m\u001b[100m));\u001b[75X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m119 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m120 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// MST means removing N+1 edges\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m121 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// We remove >= 1 from each small circle, which is >= N total\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m122 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// And the last is either a 2nd from a small circle or 1 from the big circle\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m123 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[20X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m124 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m E = N * M + N;   \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m125 \u001b(B\u001b"]
