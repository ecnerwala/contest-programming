[4169.49668, "o", "\u001b[?25l\r\u001b[30A\u001b(B\u001b[m\u001b[92m\u001b[40m212 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcost = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;                                                                                                           \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m213 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m} \u001b(B\u001b[m\u001b[32m\u001b[100melse\u001b(B\u001b[m\u001b[94m\u001b[100m {                                                                                                                \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m214 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcost = -subtree_opts[i].query(H[i]) - L[i] * H[i];                                                                  \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m215 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}                                                                                                                       \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m216 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mlines[i].push_back({-L[i], -cost});                                                           "]
[4169.496861, "o", "                          \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m217 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100msubtree_opts[i].add(-L[i], -cost);                                                                                      \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m218 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                    \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m219 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m q : queries[i]) {                                                                                              \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m220 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mans[q] = -subtree_opts[i].query(Y[q]) - L[i] * Y[q];                                                                \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m221 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}                                                                                                                      "]
[4169.496965, "o", " \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m222 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                    \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m223 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (P[i] != -\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m) {                                                                                                       \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m224 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (lines[i].size() > lines[P[i]].size()) {                                                                         \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m225 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mswap(subtree_opts[i], subtree_opts[P[i]]);                                                                      \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m226 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mswap(lines[i], lines[P[i]]);                                                                                    \r\n\u001b"]
