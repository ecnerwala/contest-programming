[2022.96319, "o", "\u001b[?25l\u001b[38A\u001b[29X\u001b[32;19HI = read_vec(Q, N*M+N);   \u001b[33;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m QW = read_vec(Q, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(\u001b(B\u001b[m\u001b[36m\u001b[100m1e9\u001b(B\u001b[m\u001b[94m\u001b[100m));\u001b[34;5H\u001b[39X\u001b[35;16H\u001b(B\u001b[m\u001b[92m\u001b[100mMST means removing N+1 edges\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[30X\u001b[36;16H\u001b(B\u001b[m\u001b[92m\u001b[100mWe remove >= 1 from each small circle, which is >= N total\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[15X\u001b[37;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// And the last is either a 2nd from a small circle or 1 from the big circle\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[38;5H\u001b[26X\u001b[39;13H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m E = N * M + N;\u001b[6X\u001b[40;13Hvector<\u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m> W(E, \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[45X\u001b[41;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m tot_weight = std::accumulate(W.begin(), W.end(), \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m(\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m));\u001b[42;5H\u001b[68X\u001b[43;13Hvector<array<set<pair<\u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[9"]
