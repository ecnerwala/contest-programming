[2042.197039, "o", "\u001b[?25l\u001b[39A\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b[31;5H»   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[32;5H\u001b[37X\u001b[33;19HI = read_vec(Q, N*M+N);   \u001b[34;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m QW = read_vec(Q, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(\u001b(B\u001b[m\u001b[36m\u001b[100m1e9\u001b(B\u001b[m\u001b[94m\u001b[100m));\u001b[35;5H\u001b[39X\u001b[36;16H\u001b(B\u001b[m\u001b[92m\u001b[100mMST means removing N+1 edges\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[30X\u001b[37;16H\u001b(B\u001b[m\u001b[92m\u001b[100mWe remove >= 1 from each small circle, which is >= N total\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[15X\u001b[38;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// And the last is either a 2nd from a small circle or 1 from the big circle\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[39;5H\u001b[26X\u001b[40;13H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m E = N * M + N;\u001b[6X\u001b[41;13Hvector<\u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m> W(E, \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[45X\u001b[42;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m tot_weight = std::accumulate(W.begin(), W.end(), \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m(\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m));\u001b[43;5H\u001b"]
[2042.197187, "o", "[68X\u001b[44;13Hvector<array<set<pair<\u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m>>, \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m>> circle_weights(N);\u001b[45;13Hset<pair<\u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m>> extra_weights;\u001b[9X\u001b[46;13Hvector<set<pair<\u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m>>*> controller(E);\u001b[47;13H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m e = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; e < E; e++) {\u001b[48;17H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (e < N * M) {  \u001b[49;25Hi = e /\u001b[50;21H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m j = e % M;\u001b[26X\u001b[51;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcontroller[e] = (X[i] <= j && j < Y[i]);\u001b[52;17H} \u001b(B\u001b[m\u001b[32m\u001b[100melse\u001b(B\u001b[m\u001b[94m\u001b[100m {\u001b[27X\u001b[53;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcontroller[e] = &extra_weights;\u001b[54;17H}\u001b[31X\u001b[55;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcontroller[e]->emplace(W[e], e);\u001b[56;13H}\u001b[2"]
