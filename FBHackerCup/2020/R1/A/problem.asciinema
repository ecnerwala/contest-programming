[1601.732847, "o", "\u001b[?25l\u001b[38;17H\u001b[33X\n\u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m downdate_node = [&](\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i) {\u001b[40;21H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (i < S) {\u001b[31X\u001b[41;43H, seg[i].min_height);    \u001b[42;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mapply_change(\u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m * i + \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m, seg[i].min_height);\u001b[43;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[44;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m};\u001b[45;5H\u001b[41X\u001b[46;17H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; i < M; i++) {\u001b[24X\u001b[47;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mseg[S+i].w = coords[i].first - coords[i-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m].first;\u001b[48;17H}\u001b[40X\u001b[49;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m a = S-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; a; --a) update_node(a);\u001b[50;5H\u001b[59X\u001b[51;17H\u001b(B\u001b[m\u001b[33m\u001b[100ma\u001b(B\u001b[m\u001b[4:3m"]
[1601.732888, "o", "\u001b[58:2::255:0:0m\u001b[33m\u001b[100mu\u001b(B\u001b[m\u001b[33m\u001b[100mto\u001b(B\u001b[m\u001b[94m\u001b[100m insert_rect = [&](\u001b(B\u001b[m\u001b[33m\u001b[100mconst\u001b(B\u001b[m\u001b[94m\u001b[100m rect& r) -> \u001b(B\u001b[m\u001b[33m\u001b[100mvoid\u001b(B\u001b[m\u001b[94m\u001b[100m {\u001b[52;17H}:\u001b[37X\u001b[53;17H\u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m get_perimeter = [&]() -> \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m {\u001b[12X\u001b[54;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m(seg[\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m].horiz) * \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m + seg[\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m].vert;\u001b[55;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m};\u001b[56;5H\u001b[24X\u001b[57;17Hnum ans = \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[13X\u001b[58;17H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mconst\u001b(B\u001b[m\u001b[94m\u001b[100m rect& r : R) {\u001b[59;21Hinsert_rect(r);\u001b[13X\u001b[60;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mans *= num(get_perimeter());\u001b[61;17H}\u001b[10X\u001b[62;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m ans;\u001b[63;13H}();\u001b[33X\u001b[64;9H\u001b(B\u001b[0;1m"]
