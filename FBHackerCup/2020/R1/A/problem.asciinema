[3131.159085, "o", "\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (i >= S) {                                                                                                       \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m215 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// should be nothing to do\u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                      \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m216 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m} \u001b(B\u001b[m\u001b[32m\u001b[100melse\u001b(B\u001b[m\u001b[94m\u001b[100m {                                                                                                            \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m217 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mseg_node& r = seg[i];                                                                                           \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m218 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[33m\u001b[100mconst\u001b(B\u001b[m\u001b[94m\u001b[100m seg_node& a = seg[\u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m*i];                                         "]
