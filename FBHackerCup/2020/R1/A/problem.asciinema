[1621.722947, "o", "\u001b[?25l\u001b(B\u001b[m\u001b[94m\u001b[100m_height\u001b[1;3H\u001b(B\u001b[m\u001b[92m\u001b[40m7 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[33m\u001b[100mconst\u001b(B\u001b[m\u001b[94m\u001b[100m seg_node& b = seg[\u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m*i+\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m];\u001b[2;3H\u001b(B\u001b[m\u001b[92m\u001b[40m8 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                 \u001b[3;3H\u001b(B\u001b[m\u001b[92m\u001b[40m9 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mr.w = a.w + b.w;               \u001b[4;2H\u001b(B\u001b[m\u001b[92m\u001b[40m10 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mr.horiz = a.horiz + b.horiz;\u001b[5;2H\u001b(B\u001b[m\u001b[92m\u001b[40m11 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mr.vert = a.vert + b.vert + abs(r.right_height - b.left_height);\u001b[6;3H\u001b(B\u001b[m\u001b[92m\u001b[40m2 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                \u001b[7;3H\u001b(B\u001b[m\u001b[92m\u001b[40m3 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mr.left_height = a.left_height;                                 \u001b[8;3H\u001b(B\u001b[m\u001b[92m\u001b[40m4 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b["]
[1621.723104, "o", "100mr.right_height = b.right_height;\u001b[9;3H\u001b(B\u001b[m\u001b[92m\u001b[40m5 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                  \u001b[10;3H\u001b(B\u001b[m\u001b[92m\u001b[40m6 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mr.min_height = min(a.min_height, b.min_height);\u001b[11;3H\u001b(B\u001b[m\u001b[92m\u001b[40m7 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mr.min_height2 = min(\u001b[12;3H\u001b(B\u001b[m\u001b[92m\u001b[40m8 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100ma.min_height == r.min_height ? a.min_height2 : a.min_height,\u001b[13;3H\u001b(B\u001b[m\u001b[92m\u001b[40m9 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mb.min_height == r.min_height ? b.min_height2 : b.min_height\u001b[14;2H\u001b(B\u001b[m\u001b[92m\u001b[40m20 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m);                                                              \u001b[15;2H\u001b(B\u001b[m\u001b[92m\u001b[40m21 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                   \u001b[16;3H\u001b(B\u001b[m\u001b[92m\u001b[40m2 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b["]
