[1965.949607, "o", "\u001b[?25l\u001b[51;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b[52;17H\u001b(B\u001b[m\u001b[94m\u001b[100m};\u001b[37X\u001b[53;17H\u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m get_perimeter = [&]() -> \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m {\u001b[12X\u001b[54;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m(seg[\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m].horiz) * \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m + seg[\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m].vert;\u001b[55;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m};\u001b[56;5H\u001b[24X\u001b[57;17Hnum ans = \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[13X\u001b[58;17H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mconst\u001b(B\u001b[m\u001b[94m\u001b[100m rect& r : R) {\u001b[59;21Hinsert_rect(r);\u001b[13X\u001b[60;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mans *= num(get_perimeter());\u001b[61;17H}\u001b[10X\u001b[62;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m ans;\u001b[63;13H}();\u001b[33X\u001b[64;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcout << \u001b(B\u001b[m\u001b[36m\u001b[100m\"Case #\"\u001b(B\u001b[m\u001b[94m\u001b[100m << case_num << \u001b(B\u001b[m\u001b[36m\u001b[100m\": "]
