[5273.730435, "o", "\u001b[?25l\u001b[17;17H\u001b[34X\n\u001b(B\u001b[m\u001b[92m\u001b[100m// i'll just do prefix/suffix sums\u001b[19;17H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (healthy[i]) {\u001b[20X\u001b[20;21H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m tot_sz = \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m + dp_up[i].cur_sz;\u001b[21;21H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m j : ch[i]) {\u001b[11X\u001b[22;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mtot_sz += dp_down[j].cur_sz;\u001b[23;21H}\u001b[20X\u001b[24;21H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m j : ch[i]) {\u001b[28X\u001b[25;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mdp_up[j].cur_sz = tot_sz - dp_down[j].cur_sz;\u001b[26;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}   \u001b[27;17H} \u001b(B\u001b[m\u001b[32m\u001b[100melse\u001b(B\u001b[m\u001b[94m\u001b[100m {\u001b[17X\u001b[28;21H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m j : ch[i]) {   \u001b[29;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mdp_up[j].cur_sz = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[30;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[31;17H}\u001b[32;17H{\u001b[26X\u001b["]
