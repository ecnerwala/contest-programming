[1050.283797, "o", "\u001b[m\u001b[94m\u001b[100m} \u001b(B\u001b[m\u001b[32m\u001b[100melse\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (r.h > curPerimeter.front().h) {\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m142 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcurP += \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m * (r.h - curPerimeter.front().h);\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m143 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m144 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m145 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mwhile\u001b(B\u001b[m\u001b[94m\u001b[100m (!curPerimeter.empty() && curPerimeter.back().h <= r.h) curPerimeter.pop_back();\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m146 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcurPerimeter.push_back(r);\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m147 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m148 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mans *= curP;\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m149 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m150 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m151 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcout << \u001b(B\u001b[m\u001b[36m\u001b"]
