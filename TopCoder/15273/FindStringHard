#include <bits/stdc++.h>
using namespace std;

namespace ecnerwala {

class FindStringHard {

	int c2(int a) {
		return a * (a-1) / 2;
	}

	int altCnt(int n) {
		return c2(n/2 + 1) + c2(n - (n/2+1) + 1);
	}
	
	int getK(int n) {
		int k = 1;
		assert(altCnt(k) == 0);
		assert(altCnt(k) <= n);
		while (altCnt(k+1) <= n) {
			k++;
		}
		return k;
	}

	string go(int n) {
		assert(n >= 0);
		int k = getK(n);
		int rem = n - altCnt(k);
		if (rem) assert(getK(rem) < k);
		string s = rem ? go(rem) : "a";
		char c = s.back();
		for (int i = 0; i < k; i++) {
			s += char(c^(i&1));
		}
		return s;
	}

	static void test() {
		FindStringHard fsh;
		for (int i = 0; i <= 1000; i++) {
			string res = fsh.go(i);
			assert(res.size() <= 100);
		}
	}

public:
	string withAntipalindromicSubstrings(int n) {
		//test();
		return go(n);
	}

};

}  // namespace ecnerwala

using ecnerwala::FindStringHard;

