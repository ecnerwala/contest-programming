template <int MOD_> struct modnum {
	static constexpr int MOD = MOD_;
	static_assert(MOD_ > 0, "MOD must be positive");

private:
	using ll = long long;

	int v;

	static int minv(int a, int m) {
		a %= m;
		assert(a);
		return a == 1 ? 1 : int(m - ll(minv(m, a)) * ll(m) / a);
	}

public:

	modnum() : v(0) {}
	modnum(ll v_) : v(int(v_ % MOD)) { if (v < 0) v += MOD; }
	explicit operator int() const { return v; }
	friend std::ostream& operator << (std::ostream& out, const modnum& n) { return out << int(n); }
	friend std::istream& operator >> (std::istream& in, modnum& n) { ll v_; in >> v_; n = modnum(v_); return in; }

	friend bool operator == (const modnum& a, const modnum& b) { return a.v == b.v; }
	friend bool operator != (const modnum& a, const modnum& b) { return a.v != b.v; }

	modnum inv() const {
		modnum res;
		res.v = minv(v, MOD);
		return res;
	}
	modnum neg() const {
		modnum res;
		res.v = v ? MOD-v : 0;
		return res;
	}
	modnum operator- () const {
		return neg();
	}
	modnum operator+ () const {
		return modnum(*this);
	}

	modnum& operator ++ () {
		v ++;
		if (v == MOD) v = 0;
		return *this;
	}
	modnum& operator -- () {
		if (v == 0) v = MOD;
		v --;
		return *this;
	}
	modnum& operator += (const modnum& o) {
		v += o.v;
		if (v >= MOD) v -= MOD;
		return *this;
	}
	modnum& operator -= (const modnum& o) {
		v -= o.v;
		if (v < 0) v += MOD;
		return *this;
	}
	modnum& operator *= (const modnum& o) {
		v = int(ll(v) * ll(o.v) % MOD);
		return *this;
	}
	modnum& operator /= (const modnum& o) {
		return *this *= o.inv();
	}

	friend modnum operator ++ (modnum& a, int) { modnum r = a; ++a; return r; }
	friend modnum operator -- (modnum& a, int) { modnum r = a; --a; return r; }
	friend modnum operator + (const modnum& a, const modnum& b) { return modnum(a) += b; }
	friend modnum operator - (const modnum& a, const modnum& b) { return modnum(a) -= b; }
	friend modnum operator * (const modnum& a, const modnum& b) { return modnum(a) *= b; }
	friend modnum operator / (const modnum& a, const modnum& b) { return modnum(a) /= b; }
};
using num = modnum<int(1e9)+7>;

struct union_find {
	vector<int> par;
	explicit union_find(int N) : par(N, -1) { }
	int getpar(int a) { return (par[a] == -1) ? a : (par[a] = getpar(par[a])); }
	bool merge(int a, int b) {
		a = getpar(a), b = getpar(b);
		if (a == b) return false;
		par[a] = b;
		return true;
	}
	bool merge(pair<int, int> p) { return merge(p.first, p.second); } // shorthand
};

mt19937 mt(48);
struct treap {
	treap* ch[2] = {nullptr, nullptr};
	~treap() {
		delete ch[0];
		delete ch[1];
	}

	mt19937::result_type pri = mt();
	pair<int, int> key;
	pair<int, int> val;
	pair<int, int> bestVal;
	void update() {
		bestVal = val;
		if (ch[0]) bestVal = max(bestVal, ch[0]->bestVal);
		if (ch[1]) bestVal = max(bestVal, ch[1]->bestVal);
	}
};

void split(pair<int, int> key, treap* r, treap* &x, treap* &y) {
	if (!r) {
		x = y = nullptr;
		return;
	}
	if (r->key < key) {
		x = r;
		split(key, r->ch[1], x->ch[1], y);
		x->update();
	} else {
		y = r;
		split(key, r->ch[0], x, y->ch[0]);
		y->update();
	}
}

void merge(treap* x, treap* y, treap* &r) {
	if (x == nullptr) {
		r = y;
		r->update();
		return;
	}
	if (y == nullptr) {
		r = x;
		r->update();
		return;
	}
	if (x->pri < y->pri) {
		r = x;
		merge(x->ch[1], y, r->ch[1]);
	} else {
		r = y;
		merge(x, y->ch[0], r->ch[0]);
	}
	r->update();
}

