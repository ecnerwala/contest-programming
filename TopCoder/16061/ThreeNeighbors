#include <bits/stdc++.h>
using namespace std;

namespace ecnerwala {

class ThreeNeighbors {

public:

	vector <string> construct(int N) {
		vector<string> ans(50, string(50, '.'));
		for (int i = 1; N >= 2; i += 3) {
			int v = min(48, N / 2);
			for (int j = 0; j <= v+1; j ++) {
				ans[i][j] = 'X';
			}
			N -= 2 * v;
		}

		if (N == 1) {
			ans[49][0] = ans[49][1] = ans[49][2] = 'X';
		}
		return ans;
	}
};

