class Hagar {

public:

	double expectedProfit(vector <int> gold) {
		std::sort(gold.begin(), gold.end());
		std::reverse(gold.begin(), gold.end());
		double ans = 0;
		double sum = 0;
		for (int i = 0; i < int(gold.size()); i++) {
			sum += 1. / gold[i];
			ans = max(ans, i / sum);
		}
		return ans;
	}
};

