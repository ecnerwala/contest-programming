#include <bits/stdc++.h>
using namespace std;

namespace ecnerwala {

class ChristmasTravel {

public:

	vector <string> plan(int N, int A) {
		if (N <= (1 << A) && A <= N * (N-1) / 2) {
			vector<vector<pair<int, int>>> pos(A);
			vector<string> ans(N, string(N, '-'));
			for (int i = 0; i < N; i++) {
				for (int j = i+1; j < N; j++) {
					int a = __builtin_ctz(i ^ j);
					pos[a].push_back({i,j});
					ans[i][j] = ans[j][i] = char('A' + a);
				}
			}
			for (int i = 0; i < A; i++) {
				for (int j = 0; pos[i].empty() && j < i; j++) {
					if (pos[j].size() >= 2) {
						int x = pos[j].back().first, y = pos[j].back().second;
						pos[i].push_back(pos[j].back());
						ans[x][y] = ans[y][x] = char('A' + i);
						pos[j].pop_back();
					}
				}
			}
			return ans;
		} else {
			return {};
		}
	}
};

