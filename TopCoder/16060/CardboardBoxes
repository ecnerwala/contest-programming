class CardboardBoxes {

public:

	long long count(long long S) {
		if (S % 2) return 0;
		S /= 2;
		long long ans = 0;
		auto checkVal = [&](long long wl, long long wh) -> long long {
			long long maxW = min(wl / 2, wh - 1);
			return maxW;
		};
		for (long long v = 1; v * v <= S; v++) {
			if (S % v == 0) {
				ans += checkVal(v, S / v);
				if (v < S / v) {
					ans += checkVal(S / v, v);
				}
			}
		}
		return ans;
	}
};

