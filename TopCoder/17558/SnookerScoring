#include <bits/stdc++.h>
using namespace std;

namespace ecnerwala {

class SnookerScoring {

public:

	vector <int> scoreN(int N, int R, int C) {
		assert(R >= 10);
		assert(C >= 2);
		if (N == 1) {
			return {1};
		} else if (N == 2) {
			return {2};
		} else if (N == 3) {
			return {1, 2};
		} else if (N == 4) {
			return {1, 3};
		} else if (N == 5) {
			return {2, 3};
		} else if (N <= C+2) {
			return {1, N-1};
		} else if (N == 9) {
			return {1, 2, 1, 2, 1, 2};
		} else {
			assert(C <= 10);
			std::vector<int> tail;
			for (int i = 2; N > (C+2) * R; i++) {
				N -= i;
				tail.push_back(i);
			}
			std::vector<int> head;
			assert(N <= (C + 2)  * R);
			for (int i = 0; N > 0; i++) {
				head.push_back(1);
				N--;
				assert(N >= 0);
				head.push_back(std::min(C+1, N));
				N -= head.back();
			}
			if (head.back() == 0) {
				if (head.size() >= 6) {
					head.end()[-5] --;
				} else {
					assert(head.end()[-3] >= 4);
					head.end()[-3] --;
				}
				head.end()[-1] ++;
			}
			if (head.back() == 1) {
				assert(head.size() >= 4);
				assert(head.end()[-3] >= 3);
				head.end()[-3] --;
				head.end()[-1] ++;
			}
			head.insert(head.end(), tail.begin(), tail.end());
			return head;
		}
	}
};

void my_tests() {
	// FILL IN TESTS
	for (int R = 10; R <= 100; R++) {
		for (int C = 2; C <= 10; C++) {
			cerr << "R = " << R << ", C = " << C << endl;
			for (int N = 1; N <= R * (C+2) + C * (C+3) / 2; N++) {
				//cerr << N << ' ' << R << ' ' << C << '\n';
				auto res = SnookerScoring().scoreN(N, R, C);
				assert(std::accumulate(res.begin(), res.end(), 0) == N);
			}
		}
	}
}

}  // namespace ecnerwala

using ecnerwala::SnookerScoring;

