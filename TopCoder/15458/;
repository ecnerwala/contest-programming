			for (int i = 0; i < int(digits.size()); i++) {
				string s;
				s += char('0' + cnts[i]);
				s += char('0' + digits[i]);
				v.push_back(s);
			}
			sort(v.begin(), v.end());
			string res;
			for (string s : v) res += s;
			return res;
		}
		ind--;
		for (int c = 1; c <= 9; c++) {
			cnts[ind] = c;
			dfs(digits, ind, )
		}
	}

	string construct(vector <int> digits) {
		int sumA = int(digits.size()) * 2;
		int sumProd = sumA;
		for (int d : digits) {
			sumProd += d;
		}
	}
};

