class SelfDescFind {

public:

	bool isGood(const vector<int>& digits, const vector<int>& cnts) {
		assert(cnts.size() == digits.size());
		int c[10]; memset(c, 0, sizeof(c));
		for (int i = 0; i < int(digits.size()); i++) {
			c[digits[i]] = cnts[i];
		}
		for (int i = 0; i < int(digits.size()); i++) {
			c[digits[i]] --;
			c[cnts[i]] --;
		}
		for (int i = 0; i < 10; i++) if (c[i]) return false;
		return true;
	}

