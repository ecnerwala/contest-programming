[8124.030931, "o", "\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m] > p[\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m]) {\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m180 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m ppt = pt; --ppt;\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m181 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcurVal -= eval(*ppt, *pt);\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m182 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mbads.erase(pt);\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m183 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mpt = ppt;\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m184 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m185 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcurVal += eval(*pt, p);\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m186 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcurVal += eval(p, *nt);\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m187 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mbads.insert(nt, p);\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m188 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m189 \u001b(B\u001b[0;1m\u001b["]
