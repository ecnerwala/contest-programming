[2492.365443, "o", "1 * (A[i]+1)) + min(R1, R1All);\u001b[18;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mcost2[i] = min(cost2[i], cost1[i]);\u001b[19;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m// just do a wiggle\u001b[20;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mcost1[i] = min(cost1[i], cost2[i] + 2 * D);\u001b[21;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m}\u001b[22;5H \u001b[23;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m// cost to clear everything in the first i levels and end at level i\u001b[24;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mvector<int64_t> pref_cost(N+1, int64_t(1e18));\u001b[25;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mpref_cost[0] = 0;\u001b[26;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mfor (int i = 0; i < N; i++) {\u001b[27;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mif (i+1 < N) {\u001b[28;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mpref_cost[i+2] = min(pref_cost[i+2], pref_cost[i] + 4 * D + cost2[i] + cost2[i+1]);\u001b[29;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m}"]
[2492.365561, "o", "\u001b[30;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mif (i+2 == N) {\u001b[31;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m// special case\u001b[32;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mpref_cost[i+2] = min(pref_cost[i+2], pref_cost[i] + 3 * D + cost2[i] + cost1[i+1]);\u001b[33;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m}\u001b[34;5H \u001b[35;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mpref_cost[i+1] = min(pref_cost[i+1], pref_cost[i] + D + cost1[i]);\u001b[36;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mpref_cost[i+1] = min(pref_cost[i+1], pref_cost[i] + 3 * D + cost2[i]);\u001b[37;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m}\u001b[38;5H \u001b[39;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m/*\u001b[40;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mfor (int i = 0; i < N; i++) {\u001b[41;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mcerr << cost1[i] << ' ' << cost2[i] << '\\n';\u001b[42;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m}\u001b[43;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7"]
