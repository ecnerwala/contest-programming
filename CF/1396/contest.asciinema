[6377.465483, "o", "\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m j = i+\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; j <= N; j++) {\u001b[52X\u001b[64;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mtot[z] += (weights[z][i+\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m] - weights[z][i]) * (weights[z][j+\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m] - weights[z][j]);\u001b[65;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[66;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[67;9H}\u001b[27X\r\n\u001b(B\u001b[0;1m\u001b[97m\u001b[43m INSERT \u001b(B\u001b[m\u001b[33m\u001b[103m\u001b(B\u001b[m\u001b[37m\u001b[103m +0 ~0 -0  masterɆ \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[96m\u001b[40m  2:modnum.hpp  \u001b(B\u001b[0;1m\u001b[94m\u001b[100m 1:D.cpp+ \u001b(B\u001b[m\u001b[96m\u001b[40m                                       \u001b(B\u001b[m\u001b[30m\u001b[40m\u001b(B\u001b[m\u001b[92m\u001b[40m cpp \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[37m\u001b[103m utf-8[unix] \u001b(B\u001b[m\u001b[33m\u001b[103m\u001b(B\u001b[m\u001b[97m\u001b[43m 84% \u001b(B\u001b[0;1m\u001b[97m\u001b[43m☰ 158/187 \u001b(B\u001b[m\u001b[97m\u001b[43m:9 \u001b(B\u001b[m\u001b[91m\u001b[43m\u001b]2;D.cpp + (~/Dropbox/programming/CF/1396/D) - NVIM\u0007\u001b[69;13H\u001b[?25h\u001b[?25l\u001b[25A\u001b[?25h"]
