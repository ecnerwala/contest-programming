[973.119565, "o", "\u001b[?25l\u001b[8;21H\u001b(B\u001b[m\u001b[4:3m\u001b[58:2::0:0:255m\u001b[94m\u001b[100m{\u001b[12;28H\u001b(B\u001b[m\u001b[94m\u001b[100m[&]() -> \u001b(B\u001b[m\u001b[33m\u001b[100mbool\u001b(B\u001b[m\u001b[94m\u001b[100m {\u001b[13;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m tot = std::accumulate(A.begin(), A.end(), \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[14;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m mx = *std::max_element(A.begin(), A.end());\u001b[15;5H \u001b[16;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// if even total & no strict majority, 2nd player wins\u001b[17;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (tot % \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m == \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m && mx <= tot/\u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m) {\u001b[18;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[36m\u001b[100mfalse\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[19;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[20;5H \u001b[21;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// If there is a (weak) maj"]
