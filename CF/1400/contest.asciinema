[1790.74057, "o", "\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[33A\u001b[79X\u001b[15;2H\u001b(B\u001b[m\u001b[92m\u001b[40m35 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m vert_cost = std::accumulate(A.begin() + l, A.begin() + r, \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m(\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m)) -\u001b[3C \u001b(B\u001b[m\u001b[92m\u001b[40m    \u001b(B\u001b[m\u001b[94m\u001b[100mh * (r-l);\u001b[17;5H\u001b[71X\u001b[18;13H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m m = \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(min_element(A.begin()+l, A.begin()+r) - A.begin());\u001b[19;13Hassert(A[m] >= h);\u001b[62X\u001b[20;13H\u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m horiz_cost = self(l, m, A[m]) + self(m+\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m, r, A[m]) + (A[m] - h) * (r-l);\u001b[21;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m min(vert_cost, horiz_cost);\u001b[22;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m})(\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m, N, \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[23;5H\u001b[24X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcout << ans << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[25;5H\u001b[13X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100"]
