[1827.392472, "o", "\u001b[?25l\u001b(B\u001b[0;7m\u001b[92m\u001b[100m#\u001b[2;5H \u001b[3;5H+-- 21 lines: namespace std {······························································\u001b[4;5H \u001b[5;5Hint main() {\u001b[6;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100musing namespace std;\u001b[7;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mios_base::sync_with_stdio(false), cin.tie(nullptr);\u001b[8;5H \u001b[9;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mint N; cin >> N;\u001b[10;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mvector<int64_t> A(N); for (auto& a : A) cin >> a;\u001b[11;5H \u001b[12;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mint64_t ans = std::y_combinator([&](auto self, int l, int r, int64_t h) -> int64_t {\u001b[13;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mif (l == r) return 0;\u001b[14;5H \u001b[15;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mint64_t vert_cost = (r-l);\u001b[16;5H \u001b[17;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mint m = int(min_element(A.begin()+l, A.begin()+r) - A.begin());\u001b"]
[1827.392696, "o", "[18;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100massert(A[m] >= h);\u001b[19;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mint64_t horiz_cost = self(l, m, A[m]) + self(m+1, r, A[m]) + (A[m] - h);\u001b[20;5H \u001b[21;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mreturn min(vert_cost, horiz_cost);\u001b[22;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m})(0, N, 0);\u001b[23;5H \u001b[24;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mcout << ans << '\\n';\u001b[25;5H \u001b[26;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mreturn 0;\u001b[27;5H\u001b(B\u001b[0;1m\u001b[31m\u001b[102m}\u001b[46;56H\u001b(B\u001b[m\u001b[30m\u001b[40m\u001b(B\u001b[m\u001b[92m\u001b[40m cpp \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[37m\u001b[103m utf-8[unix] \u001b(B\u001b[m\u001b[35m\u001b[103m\u001b(B\u001b[m\u001b[97m\u001b[45m 100% \u001b(B\u001b[0;1m\u001b[97m\u001b[45m☰ 47\u001b[27;5H\u001b[?25h"]
