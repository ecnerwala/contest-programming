[5253.751362, "o", "\u001b[m\u001b[94m\u001b[100m (k0 + k1 > K) \u001b(B\u001b[m\u001b[32m\u001b[100mcontinue\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m239 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m cnd = k0 * k1;\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m240 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; i < k0; i++) {\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m241 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcnd += cur_val_0[i];\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m242 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m243 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; i < k1; i++) {\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m244 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcnd += cur_val_1[i];\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m245 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[K\u001b[46;173H\u001b(B\u001b[m\u001b[97m\u001b[106m9% \u001b(B\u001b[0;1m\u001b[97m\u001b[106m☰ 241/3"]
