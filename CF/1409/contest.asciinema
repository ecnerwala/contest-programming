[4934.185856, "o", "\u001b[?25l\u001b[15;9Hassert(\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(T.size()) == \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[16;9H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (T[\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m] == T[\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m]) {\u001b[17;13H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m cnt = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[17X\u001b[18;13H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; i < N; i++) {\u001b[19;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcnt += S[i] == T[\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m];\u001b[20;13H}\u001b[21X\nnt = min(cnt + K, N);\u001b[28X\u001b[22;13Hcout << \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m(cnt) * \u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m(cnt-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m) / \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[23;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mexit(\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[24;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[25;5H\u001b[25X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b"]
[4934.186006, "o", "[m\u001b[94m\u001b[100massert(T[\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m] != T[\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m]);\u001b[27;5H\u001b[97X\u001b[28;12H\u001b(B\u001b[m\u001b[92m\u001b[100msplit the array into 2 pieces based on where we change -> T[0] and where we change to T[1]\u001b[29;12H# 0's on left is orig 0's + K_0, # 1's on the right is orig 1's + K_1\u001b[30;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// left_internal + (left 0's + K_0) * (right 1's + K_1) + right_internal\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[31;5H\u001b[72X\u001b[32;12H\u001b(B\u001b[m\u001b[92m\u001b[100mGreedy means that we should pick 4 number's K_0, K_10, K_1, K_01;\u001b[33;21H0 leftmost randoms, K_10 leftmost 1's to 0\u001b(B\u001b[m\u001b[94m\u001b[100m  \u001b[34;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// change K_1 rightmost randoms, K_01 rightmost 0's to 1\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[35;5H\u001b[28X\u001b[36;13H\u001b(B\u001b[m\u001b[92m\u001b[100mx10x1x\u001b[37;11H 00000100xxxxx0xx0xxx1\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[38;11H\u001b[57X\u001b[39;12H\u001b(B\u001b[m\u001b[92m\u001b[100mclosed form of left_internal: sum of last indices of 1's\u001b[40;12Hx -> 0 benefit is # 1's to the right\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[6X\u001b[41;12H\u001b(B\u001b[m\u001b[92m\u001b[100m1 -> 0 benefi"]
[4934.186108, "o", "t is # 1's to the right - idx\u001b[42;11H **Can greedy on these**\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[43;11H\u001b[100X\u001b[44;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// pick k_0 best val_0's and k_1 best val_1's so that sum(val_0) + sum(val_1) + k_0 * k_1 is maximized\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[45;5H\u001b[28X\u001b[46;31H\u001b(B\u001b[m\u001b[96m\u001b[40m \u001b(B\u001b[0;1m\u001b[94m\u001b[100m 1:F.cpp+ \u001b(B\u001b[m\u001b[96m\u001b[40m                                                                                                             \u001b(B\u001b[m\u001b[30m\u001b[40m\u001b(B\u001b[m\u001b[92m\u001b[40m cpp \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[37m\u001b[103m utf-8[unix] \u001b(B\u001b[m\u001b[96m\u001b[103m\u001b(B\u001b[m\u001b[97m\u001b[106m 47% \u001b(B\u001b[0;1m\u001b[97m\u001b[106m☰ 161/341 \u001b(B\u001b[m\u001b[97m\u001b[106m:5\u001b]2;F.cpp + (~/Dropbox/programming/CF/1409/F) - NVIM\u0007\u001b[13;5H\u001b[?25h"]
