[4294.243321, "o", "\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// split the array into 2 pieces based on where we change -> T[0] and where we change  \u001b(B\u001b[m\u001b[92m\u001b[40m    \u001b(B\u001b[m\u001b[92m\u001b[100mto T[1]\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m175 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// # 0's on left is orig 0's + K_0, # 1's on the right is orig 1's + K_1\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m176 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// left_internal + (left 0's + K_0) * (right 1's + K_1) + right_internal\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m177 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[40X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m178 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// Greedy means that we should pick 4 number's K_0, K_10, K_1, K_01;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m179 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// change K_0 leftmost randoms, K_10 leftmost 1's to 0\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m180 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// change K_1 rightmost randoms, K_01 rightmost 0's to 1\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m181 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[24X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m182 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// 0x10x1x0xxxxx0xx0xxx1\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m183 \u001b(B\u001b[0;1m\u001b[30m"]
[4294.243398, "o", "\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// 00000100xxxxx0xx0xxx1\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m184 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m//\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[10X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m185 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// closed form of left_internal: sum of last indices of 1's\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m186 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// x -> 0 benefit is # 1's to the right\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m187 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// 1 -> 0 benefit is # 1's to the right - idx\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m188 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// **Can greedy on these**\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m189 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m//\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m190 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// pick k_0 best val_0's and k_1 best val_1's so that sum(val_0) + sum(val_1) + k_0 *  \u001b(B\u001b[m\u001b[92m\u001b[40m    \u001b(B\u001b[m\u001b[92m\u001b[100mk_1 is maximized\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[13X\u001b[46;24H\u001b(B\u001b[m\u001b[92m\u001b[40mnsor.hpp  \u001b(B\u001b[0;1m\u001b[94m\u001b[100m 1:F.cpp  \u001b(B\u001b[m\u001b[92m\u001b[40m  \u001b(B\u001b[m\u001b[30m\u001b[40m\u001b(B\u001b[m\u001b[92m\u001b[40m cpp \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[37m\u001b[103m utf-8[un"]
