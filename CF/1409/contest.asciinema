[4150.021449, "o", "\u001b[?25l\u001b[H\u001b(B\u001b[m\u001b[92m\u001b[40m290 \u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m{\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[18X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m291 \u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mint c0 = 0;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m292 \u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mfor (int i = 0; i < N; i++) {\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m293 \u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mif (S[i] == T[1]) ans += c0;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m294 \u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100melse if (S[i] == T[0]) c0++;\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m295 \u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m}\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m296 \u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m}\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[61X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m297 \u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mcout << ans << '\\n';\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m298 \u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m*/\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[6X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m299 \u001b(B\u001b[0;7m\u001b[92m\u001b[100m \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[23X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m300 \u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m/"]
