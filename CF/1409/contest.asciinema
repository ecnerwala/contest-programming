[5474.508245, "o", "  \u001b(B\u001b[m\u001b[94m\u001b[100mexit(\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m171 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m172 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m173 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100massert(T[\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m] != T[\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m]);\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m174 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m175 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// split the array into 2 pieces based on where we change -> T[0] and where we change to T[1]\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m176 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// # 0's on left is orig 0's + K_0, # 1's on the right is orig 1's + K_1\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m177 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// left_internal + (left 0's + K_0) * (right 1's + K_1) + right_internal\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\u001b[46;174H\u001b(B\u001b[m\u001b[97m\u001b[106m9% \u001b(B\u001b[0;1m\u001b[97m\u001b[106m☰ 135\u001b[3;9H\u001b[?25h"]
