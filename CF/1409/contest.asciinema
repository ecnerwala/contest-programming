[4927.782617, "o", "»   \u001b(B\u001b[m\u001b[92m\u001b[100mtensor<int, 3> dp({N+1, N+1, K+1}, -1);\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m308 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100mdp[{0, 0, 0}] = 0;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m309 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[58X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m310 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100mfor (int i = 0; i < N; i++) {\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m311 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[92m\u001b[100mfor (int c0 = 0; c0 <= N; c0++) {\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m312 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100mfor (int k = 0; k <= K; k++) {\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[15X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m313 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100mif (dp[{i, c0, k}] == -1) continue;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m314 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// treat it as nothing\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[33X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m315 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100msetmax(dp[{i+1, c0, k}], dp[{i, c0, k}]);\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m316 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[5X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m317 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// change it to T[0]\u001b(B\u001b[m\u001b[94m\u001b[100m"]
