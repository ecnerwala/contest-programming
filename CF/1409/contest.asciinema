[3522.407676, "o", "\u001b[33;5H\u001b[33X\u001b[34;9H\u001b(B\u001b[m\u001b[92m\u001b[100mfor (int i = 0; i < N; i++) {\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[8X\u001b[35;13H\u001b(B\u001b[m\u001b[92m\u001b[100mfor (int c0 = 0; c0 <= N; c0++) {\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b[36;17H\u001b(B\u001b[m\u001b[92m\u001b[100mfor (int k = 0; k <= K; k++) {\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[9X\u001b[37;21H\u001b(B\u001b[m\u001b[92m\u001b[100mif (dp[{i, c0, k}] == -1) continue;\u001b[38;21H// treat it as nothing\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[19X\u001b[39;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100msetmax(dp[{i+1, c0, k}], dp[{i, c0, k}]);\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[40;5H\u001b[36X\u001b[41;21H\u001b(B\u001b[m\u001b[92m\u001b[100m// change it to T[0]\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[23X\u001b[42;21H\u001b(B\u001b[m\u001b[92m\u001b[100mif (k + (S[i] != T[0]) <= K && c0+1 <= N) {\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[21X\u001b[43;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100msetmax(dp[{i+1, c0+1, k + (S[i] != T[0])}], dp[{i, c0, k}]);\u001b[44;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100m}\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[45;5H\u001b[36X\r\n\u001b(B\u001b[0;1m\u001b[97m\u001b[43m INSERT \u001b(B\u001b[m\u001b[33m\u001b[103m\u001b(B\u001b[m\u001b[37m\u001b[103m  masterɆ \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[96m\u001b[40m <r.hpp  \u001b(B\u001b[0;1m\u001b[94m\u001b[100m 1:F.cpp+ \u001b(B\u001b[m\u001b[96m\u001b[40m  \u001b(B\u001b[m\u001b"]
