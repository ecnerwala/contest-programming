[3856.252837, "o", "'s on left is orig 0's + K_0, # 1's on the right is orig 1's + K_1\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m176 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// left_internal + (left 0's + K_0) * (right 1's + K_1) + right_internal\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m177 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m178 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// Greedy means that we should pick 4 number's K_0, K_10, K_1, K_01;\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m179 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// change K_0 leftmost randoms, K_10 leftmost 1's to 0\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m180 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// change K_1 rightmost randoms, K_01 rightmost 0's to 1\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m181 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m182 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// 0x10x1x0xxxxx0xx0xxx1\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m183 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// 00000100xxxxx0xx0xxx1\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m184 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b["]
[3856.252929, "o", "m\u001b[92m\u001b[100m//\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m185 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// closed form of left_internal: sum of last indices of 1's\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m186 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// x -> 0 benefit is # 1's to the right\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m187 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// 1 -> 0 benefit is # 1's to the right - idx\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m188 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// **Can greedy on these**\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\u001b[46;78H\u001b(B\u001b[m\u001b[97m\u001b[106m2% \u001b(B\u001b[0;1m\u001b[97m\u001b[106m☰ 192/307 \u001b(B\u001b[m\u001b[97m\u001b[106m:5\u001b[26;9H\u001b[?25h"]
