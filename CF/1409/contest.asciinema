[3532.207859, "o", "[11X\u001b[35;5H\u001b[41X\u001b[36;9H\u001b(B\u001b[m\u001b[92m\u001b[100mfor (int i = 0; i < N; i++) {\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[9X\u001b[37;13H\u001b(B\u001b[m\u001b[92m\u001b[100mfor (int c0 = 0; c0 <= N; c0++) {\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[10X\u001b[38;17H\u001b(B\u001b[m\u001b[92m\u001b[100mfor (int k = 0; k <= K; k++) {\u001b[39;21Hif (dp[{i, c0, k}] == -1) continue;\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[6X\u001b[40;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// treat it as nothing\u001b[41;21Hsetmax(dp[{i+1, c0, k}], dp[{i, c0, k}]);\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[42;5H\u001b[59X\u001b[43;21H\u001b(B\u001b[m\u001b[92m\u001b[100m// change it to T[0]\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[44X\u001b[44;21H\u001b(B\u001b[m\u001b[92m\u001b[100mif (k + (S[i] != T[0]) <= K && c0+1 <= N) {\u001b[45;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100msetmax(dp[{i+1, c0+1, k + (S[i] != T[0])}], dp[{i, c0, k}]);\u001b[46;72H\u001b(B\u001b[0;1m\u001b[97m\u001b[43m1/278 \u001b(B\u001b[m\u001b[97m\u001b[43m:13\u001b[18;20H\u001b(B\u001b[m\u001b[94m\u001b[100m{\u001b[19;17H\u001b[?25h"]
