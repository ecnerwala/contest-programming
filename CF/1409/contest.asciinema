[4083.187769, "o", "\u001b[?25l\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[11;9H  \u001b[12;9H\u001b(B\u001b[0;1m\u001b[31m\u001b[100m/\u001b(B\u001b[m\u001b[92m\u001b[100m*\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[37X\u001b[13;9H\u001b(B\u001b[m\u001b[92m\u001b[100mtensor<int, 3> dp({N+1, N+1, K+1}, -1);\u001b[14;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100mdp[{0, 0, 0}] = 0;\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[15;5H\u001b[33X\u001b[16;9H\u001b(B\u001b[m\u001b[92m\u001b[100mfor (int i = 0; i < N; i++) {\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[8X\u001b[17;13H\u001b(B\u001b[m\u001b[92m\u001b[100mfor (int c0 = 0; c0 <= N; c0++) {\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b[18;17H\u001b(B\u001b[m\u001b[92m\u001b[100mfor (int k = 0; k <= K; k++) {\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[9X\u001b[19;21H\u001b(B\u001b[m\u001b[92m\u001b[100mif (dp[{i, c0, k}] == -1) continue;\u001b[20;21H// treat it as nothing\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[19X\u001b[21;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100msetmax(dp[{i+1, c0, k}], dp[{i, c0, k}]);\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[22;5H\u001b[36X\u001b[23;21H\u001b(B\u001b[m\u001b[92m\u001b[100m// change it to T[0]\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[23X\u001b[24;21H\u001b(B\u001b[m\u001b[92m\u001b[100mif (k + (S[i] != T[0]) <= K && c0+1 <= N) {\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[21X\u001b[25;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100msetmax(dp[{i+1, c0+1, k + (S[i] != T[0])}], dp[{i, c0, k}]);\u001b[26;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100"]
[4083.187997, "o", "m»   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100m}\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[27;5H\u001b[36X\u001b[28;21H\u001b(B\u001b[m\u001b[92m\u001b[100m// change it to T[1]\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[10X\u001b[29;21H\u001b(B\u001b[m\u001b[92m\u001b[100mif (k + (S[i] != T[1]) <= K) {\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[37X\u001b[30;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100msetmax(dp[{i+1, c0, k + (S[i] != T[1])}], dp[{i, c0, k}] + c0);\u001b[31;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m}\u001b[32;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m}\u001b[33;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m}\u001b[34;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m}\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[35;5H\u001b[16X\u001b[36;9H\u001b(B\u001b[m\u001b[92m\u001b[100mint ans = 0;\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[21X\u001b[37;9H\u001b(B\u001b[m\u001b[92m\u001b[100mfor (int c0 = 0; c0 <= N; c0++) {\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b[38;13H\u001b(B\u001b[m\u001b[92m\u001b[100mfor (int k = 0; k <= K; k++) {\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[5X\u001b[39;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100mans = max(ans, dp[{N, c0, k}]);\u001b[40;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m}\u001b[41;9H}\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[19X\u001b[42;9H\u001b(B\u001b[m\u001b[92m\u001b[100mcout << ans << '\\n';\u001b[43;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m*/\u001b(B"]
