[5042.537125, "o", "    \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m186 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// closed form of left_internal: sum of last indices of 1's\u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                            \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m187 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// x -> 0 benefit is # 1's to the right\u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                                \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m188 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// 1 -> 0 benefit is # 1's to the right - idx\u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                          \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m189 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// **Can greedy on these**\u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                         "]
[5042.537243, "o", "                                    \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m190 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m//\u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                                                                     \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m191 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// pick k_0 best val_0's and k_1 best val_1's so that sum(val_0) + sum(val_1) + k_0 * k_1 is maximized\u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                 \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m192 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                                                                           \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m193 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mvector<\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m> suff_1(N+\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m);                                                                              "]
[5042.537343, "o", "                                                                                 \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m194 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mvector<\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m> pref_0(N+\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m);                                                                                                                                                               \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m195 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; i < N; i++) {                                                                                                                                                          \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m196 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100mpref_0[i+\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m] = pref_0[i] + (S[i] == T[\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m]);                                                                                                                      "]
[5042.537424, "o", "                    \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m197 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}                                                                                                                                                                                      \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m198 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = N-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; i >= \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; i--) {                                                                                                                                                       \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m199 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100msuff_1[i] = suff_1[i+\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m] + (S[i] == T[\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m]);                                                                                                                                          \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m200 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}          "]
[5042.5375, "o", "                                                                                                                                                                            \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m201 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                                                                           \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m202 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mvector<\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m> val_0(N);                                                                                                                                                                  \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m203 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mvector<\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m> val_1(N);                                                                                                                                                                  \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m204 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100m"]
