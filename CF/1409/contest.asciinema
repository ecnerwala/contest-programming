[4077.028066, "o", "\u001b[?25l\u001b[47;85H \u001b[H\u001b(B\u001b[m\u001b[92m\u001b[40m281 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[28X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m282 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m{\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[23X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m283 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[92m\u001b[100mint c0 = 0;\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[14X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m284 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[92m\u001b[100mfor (int i = 0; i < N; i++) {\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[12X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m285 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100mif (S[i] == T[1]) ans += c0;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m286 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100melse if (S[i] == T[0]) c0++;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m287 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[92m\u001b[100m}\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[40X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m288 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m}\u001b[9;2H\u001b(B\u001b[m\u001b[92m\u001b[40m89 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100mcout << ans << '\\n';\u001b[10;2H\u001b(B\u001b[m\u001b[92m\u001b[40m90 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[25X\u001b[11;2H\u001b(B\u001b[m\u001b[92m\u001b[40m91 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;1m\u001b[31m\u001b[100m/\u001b(B\u001b[m\u001b[92m\u001b[100m*\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[19X\u001b[12;2H\u001b(B\u001b[m\u001b[92m\u001b[40m92 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m"]
[4077.028127, "o", "»   \u001b(B\u001b[m\u001b[92m\u001b[100mtensor<int, 3> dp({N+1, N+1, K+1}, -1);\u001b[13;2H\u001b(B\u001b[m\u001b[92m\u001b[40m93 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100mdp[{0, 0, 0}] = 0;\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[5X\u001b[14;2H\u001b(B\u001b[m\u001b[92m\u001b[40m94 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[25X\u001b[15;2H\u001b(B\u001b[m\u001b[92m\u001b[40m95 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100mfor (int i = 0; i < N; i++) {\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[18X\u001b[16;2H\u001b(B\u001b[m\u001b[92m\u001b[40m96 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[92m\u001b[100mfor (int c0 = 0; c0 <= N; c0++) {\u001b[17;2H\u001b(B\u001b[m\u001b[92m\u001b[40m97 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100mfor (int k = 0; k <= K; k++) {\u001b[18;2H\u001b(B\u001b[m\u001b[92m\u001b[40m98 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100mif (dp[{i, c0, k}] == -1) continue;\u001b[19;2H\u001b(B\u001b[m\u001b[92m\u001b[40m99 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// treat it as nothing\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m300 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100msetmax(dp[{i+1, c0, k}], dp[{i, c0, k}]);\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m301 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[33X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m302 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// change "]
