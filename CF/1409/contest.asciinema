[5255.222504, "o", "\u001b[?25l\u001b[1;45r\u001b[H\u001b[22L\u001b[r\u001b[H\u001b(B\u001b[m\u001b[92m\u001b[40m179 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// Greedy means that we should pick 4 number's K_0, K_10, K_1, K_01;\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m180 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// change K_0 leftmost randoms, K_10 leftmost 1's to 0\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m181 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// change K_1 rightmost randoms, K_01 rightmost 0's to 1\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m182 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m183 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// 0x10x1x0xxxxx0xx0xxx1\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m184 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// 00000100xxxxx0xx0xxx1\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m185 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m//\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m186 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// closed form of left_internal: sum of last indices of 1's\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m187 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// x -> 0 benefit "]
[5255.222689, "o", "is # 1's to the right\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m188 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// 1 -> 0 benefit is # 1's to the right - idx\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m189 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// **Can greedy on these**\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m190 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m//\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m191 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// pick k_0 best val_0's and k_1 best val_1's so that sum(val_0) + sum(val_1) + k_0 * k_1 is maximized\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m192 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m193 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m orig_ans = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m194 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m{\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m195 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m c0 = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m196 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b("]
