[5438.885441, "o", "\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// x -> 0 benefit is # 1's to the right\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m188 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// 1 -> 0 benefit is # 1's to the right - idx\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m189 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// **Can greedy on these**\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m190 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m//\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m191 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// pick k_0 best val_0's and k_1 best val_1's so that sum(val_0) + sum(val_1) + k_0 * k_1 is maximized\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m192 \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m193 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m orig_ans = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m194 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m{\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m195 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m c0 = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m196 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   "]
