[4780.740145, "o", "50;25HB << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[57X\u001b[51;26H\u001b(B\u001b[m\u001b[36m\u001b[100mndp\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m' '\u001b(B\u001b[m\u001b[94m\u001b[100m; \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (num i : ndp) { cerr << i << \u001b(B\u001b[m\u001b[36m\u001b[100m' '\u001b(B\u001b[m\u001b[94m\u001b[100m; } cerr << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[8X\u001b[52;17Hcerr << \u001b(B\u001b[m\u001b[36m\u001b[100m\"slow_dp\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m' '\u001b(B\u001b[m\u001b[94m\u001b[100m; \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (num i : slow_dp) { cerr << i << \u001b(B\u001b[m\u001b[36m\u001b[100m' '\u001b(B\u001b[m\u001b[94m\u001b[100m; } cerr << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[53;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100massert(slow_dp == ndp);\u001b[54;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[55;5H\u001b[25X\u001b[56;13HA = std::move(B);   \u001b[57;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100mdp = std::move(ndp);\u001b[58;5H\u001b[35X\u001b[59;21H\u001b(B\u001b[m\u001b[36m\u001b[100m\"finished\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[60;13Hcerr << A << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[34X\u001b[61;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[1"]
