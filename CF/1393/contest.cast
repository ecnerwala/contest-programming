[4916.029648, "o", "\u001b[?25l\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100mB.resize(y);\u001b[16;5H\u001b[9X\u001b[17;13H{\u001b[28X\u001b[18;17Hvector<num> slow_dp(y+\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[5X\u001b[19;17H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; i <= x; i++) {\u001b[20;21Hstring s = A;\u001b[19X\u001b[21;21H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (i < x) s.erase(s.begin()+i);\u001b[22;21H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m j = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; j <= y; j++) {\u001b[23;25Hstring t = B;\u001b[19X\u001b[24;25H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (j < y) t.erase(t.begin()+j);\u001b[15X\u001b[25;25Hcerr << s << \u001b(B\u001b[m\u001b[36m\u001b[100m' '\u001b(B\u001b[m\u001b[94m\u001b[100m << t << \u001b(B\u001b[m\u001b[36m\u001b[100m' '\u001b(B\u001b[m\u001b[94m\u001b[100m << (s<=t) << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[26;25H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (s <= t) {\u001b[11X\u001b[27;25H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mslow_dp[j] += dp[i];\u001b[28;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[29;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m"]
[4916.029779, "o", "\u001b[94m\u001b[100m}\u001b[30;17H}\u001b[26X\u001b[31;25H\u001b(B\u001b[m\u001b[36m\u001b[100m\"finished\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[32;25HB << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[57X\u001b[33;26H\u001b(B\u001b[m\u001b[36m\u001b[100mndp\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m' '\u001b(B\u001b[m\u001b[94m\u001b[100m; \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (num i : ndp) { cerr << i << \u001b(B\u001b[m\u001b[36m\u001b[100m' '\u001b(B\u001b[m\u001b[94m\u001b[100m; } cerr << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[8X\u001b[34;17Hcerr << \u001b(B\u001b[m\u001b[36m\u001b[100m\"slow_dp\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m' '\u001b(B\u001b[m\u001b[94m\u001b[100m; \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (num i : slow_dp) { cerr << i << \u001b(B\u001b[m\u001b[36m\u001b[100m' '\u001b(B\u001b[m\u001b[94m\u001b[100m; } cerr << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[35;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100massert(slow_dp == ndp);\u001b[36;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[37;5H\u001b[25X\u001b[38;13HA = std::move(B);   \u001b[39;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100mdp = std::move(ndp);\u001b[40;5H\u001b[35X\u001b[41;21H\u001b(B\u001b[m\u001b[36m\u001b[100m\"finished\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m"]
[4916.029866, "o", "\u001b[94m\u001b[100m;\u001b[42;13Hcerr << A << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[34X\u001b[43;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (num i : dp) { cerr << i << \u001b(B\u001b[m\u001b[36m\u001b[100m' '\u001b(B\u001b[m\u001b[94m\u001b[100m; } cerr << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[44;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[45;5H\u001b[55X\u001b[46;9Hnum ans = accumulate(dp.begin(), dp.end(), num(\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m));\u001b[47;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcout << ans << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[48;5H\u001b[13X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m234 \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[K\u001b[57;31H\u001b(B\u001b[m\u001b[96m\u001b[40m  2:manacher.hpp   3:modnum.hpp   8:  \u001b(B\u001b[0;1m\u001b[94m\u001b[100m 1:E1.cpp+ \u001b(B\u001b[m\u001b[96m\u001b[40m                \u001b(B\u001b[m\u001b[30m\u001b[40m\u001b(B\u001b[m\u001b[92m\u001b[40m cpp \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[37m\u001b[103m utf-8[unix] \u001b(B\u001b[m\u001b[96m\u001b[103m\u001b(B\u001b[m\u001b[97m\u001b[106m 85% \u001b(B\u001b[0;1m\u001b[97m\u001b[106m☰ 199/234 \u001b(B\u001b[m\u001b[97m\u001b[106m:9\u001b]2;E1.cpp + (~/Dropbox/programming/"]
