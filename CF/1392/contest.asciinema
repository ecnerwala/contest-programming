[13157.152003, "o", "\u001b[m\u001b[92m\u001b[100m// we can handle the 1good 2bad by wrapping in a white/back ring and adding the 2\u001b(B\u001b[m\u001b[94m\u001b[100m                                                   \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m235 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                    \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m236 \u001b(B\u001b[m\u001b[92m\u001b[100m// Each cc can be uniquely identified by a max-row max-col cross such that neither can reach further\u001b(B\u001b[m\u001b[94m\u001b[100m                                \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m237 \u001b(B\u001b[m\u001b[92m\u001b[100m//\u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                  \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m238 \u001b(B\u001b[m\u001b[92m\u001b[100m// Conjecture: the blockers match\u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                   \r\n\u001b(B\u001b[0;1m\u001b[97m\u001b[106m COMMAND \u001b(B\u001b[m\u001b[96m\u001b[103m\u001b(B\u001b[m\u001b[37m\u001b[103m +0 ~0 -0  masterɆ \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[92m\u001b[40m"]
