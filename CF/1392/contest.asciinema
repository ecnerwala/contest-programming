[10960.516314, "o", "\u001b[59;5H\u001b[5X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[61;5H}\u001b[12X\u001b[62;5H \u001b[63;5H\u001b(B\u001b[m\u001b[92m\u001b[100m// we can handle the 1good 2bad by wrapping in a white/back ring and adding the 2\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[64;5H\u001b[81X\n\u001b(B\u001b[m\u001b[92m\u001b[100m// Each cc can be uniquely identified by a max-row max-col cross such that neither can reach further\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[66;7H\u001b[98X\n\u001b(B\u001b[m\u001b[92m\u001b[100m Conjecture: the blockers match\u001b[68;31H\u001b(B\u001b[m\u001b[96m\u001b[40m \u001b(B\u001b[0;1m\u001b[94m\u001b[100m 1:I.cpp+ \u001b(B\u001b[m\u001b[96m\u001b[40m                                                     \u001b(B\u001b[m\u001b[30m\u001b[40m\u001b(B\u001b[m\u001b[92m\u001b[40m cpp \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[37m\u001b[103m utf-8[unix] \u001b(B\u001b[m\u001b[96m\u001b[103m\u001b(B\u001b[m\u001b[97m\u001b[106m 87% \u001b(B\u001b[0;1m\u001b[97m\u001b[106m☰ 210/239 \u001b(B\u001b[m\u001b[97m\u001b[106m:21\u001b]2;I.cpp + (~/Dropbox/programming/CF/1392/I) - NVIM\u0007\u001b[38;13H\u001b[?25h"]
