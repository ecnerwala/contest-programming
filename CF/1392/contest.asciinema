[13232.984919, "o", "\u001b[?25l\r\n\n\u001b(B\u001b[m\u001b[92m\u001b[40m  3 \u001b(B\u001b[m\u001b[33m\u001b[100mnamespace\u001b(B\u001b[m\u001b[94m\u001b[100m fft {\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m  4 \u001b(B\u001b[m\u001b[32m\u001b[100musing\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[33m\u001b[100mnamespace\u001b(B\u001b[m\u001b[94m\u001b[100m std;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m  5 \u001b(B\u001b[m\u001b[91m\u001b[100m#define rep(i, a, b) \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[91m\u001b[100m(\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[91m\u001b[100m i = a; i < (b); ++i)\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m  6 \u001b(B\u001b[m\u001b[91m\u001b[100m#define trav(a, x) \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[91m\u001b[100m(\u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[91m\u001b[100m& a : x)\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m  7 \u001b(B\u001b[m\u001b[91m\u001b[100m#define all(x) x.begin(), x.end()\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[48X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m  8 \u001b(B\u001b[m\u001b[91m\u001b[100m#define sz(x) (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[91m\u001b[100m)(x).size()\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m  9 \u001b(B\u001b[m\u001b[33m\u001b[100mtypedef\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[33m\u001b[100mlong\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[33m\u001b[100mlong\u001b(B\u001b[m\u001b[94m\u001b[100m ll;\u001b[79X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m 10 \u001b(B\u001b[m\u001b[33m\u001b[100mtypedef\u001b(B\u001b[m\u001b[94m\u001b[100m pair<\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m> pii;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m"]
