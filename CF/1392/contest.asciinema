[18321.420455, "o", "num \u001b(B\u001b[m\u001b[32m\u001b[100moperator\u001b(B\u001b[m\u001b[94m\u001b[100m+(num a, num b) { \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m num(a.x + b.x, a.y + b.y); }\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m 21 \u001b(B\u001b[m\u001b[33m\u001b[100minline\u001b(B\u001b[m\u001b[94m\u001b[100m num \u001b(B\u001b[m\u001b[32m\u001b[100moperator\u001b(B\u001b[m\u001b[94m\u001b[100m-(num a, num b) { \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m num(a.x - b.x, a.y - b.y); }\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m 22 \u001b(B\u001b[m\u001b[33m\u001b[100minline\u001b(B\u001b[m\u001b[94m\u001b[100m num \u001b(B\u001b[m\u001b[32m\u001b[100moperator\u001b(B\u001b[m\u001b[94m\u001b[100m*(num a, num b) { \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m num(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x); }\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m 23 \u001b(B\u001b[m\u001b[33m\u001b[100minline\u001b(B\u001b[m\u001b[94m\u001b[100m num conj(num a) { \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m num(a.x, -a.y); }\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m 24 \u001b(B\u001b[m\u001b[33m\u001b[100minline\u001b(B\u001b[m\u001b[94m\u001b[100m num inv(num a) { dbl n = (a.x*a.x+a.y*a.y); \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m num(a.x/n,-a.y/n); }\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m 25 \u001b(B\u001b[m\u001b[92m\u001b[100m/// end-hash\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[49X\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m 26 \u001b(B\u001b[m\u001b[91m\u001b[100m#else\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m 27 \u001b(B\u001b[m\u001b[92m\u001b[100m// NTT\u001b(B\u001b[m"]
