[4782.205493, "o", "\u001b[16;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mifact[V] = inv(fact[V]);\u001b[17;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mfor (int i = V; i >= 1; i--) ifact[i-1] = ifact[i] * num(i);\u001b[18;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mauto choose = [&](int n, int r) -> num {\u001b[19;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100massert(0 <= r && r <= n);\u001b[20;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mreturn fact[n] * ifact[r] * ifact[n-r];\u001b[21;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m};\u001b[22;5H \u001b[23;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mnum ans = 0;\u001b[24;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mfor (int k = 1; k <= N; k++) {\u001b[25;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mans += num(k % 2 ? 1 : -1) * choose(N, k) * num(M+k) * (fact[k-1] * ifact[k]);\u001b[26;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m}\u001b[27;5H \u001b[28;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mans *= (1 + num(N) / num(M+1));\u001b[29;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mcou"]
