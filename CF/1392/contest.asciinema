[18369.851722, "o", "\u001b[m\u001b[94m\u001b[100m num { \u001b(B\u001b[m\u001b[92m\u001b[100m/// start-hash\u001b[18;9H\u001b(B\u001b[m\u001b[94m\u001b[100mdbl x, y;\u001b[37X\u001b[19;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mnum(dbl x_ = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m, dbl y_ = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m) : x(x_), y(y_) { }\u001b[20;5H};\u001b[70X\u001b[21;24H+(num a, num b) { \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m num(a.x + b.x, a.y +\u001b[22;24H-(num a, num b) { \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m num(a.x - b.x, a.y - b.y); }\u001b[24X\u001b[23;16H\u001b(B\u001b[m\u001b[32m\u001b[100moperator\u001b(B\u001b[m\u001b[94m\u001b[100m*(num a, num b) { \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m num(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x); }\u001b[24;16Hconj(num a) { \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m num(a.x, -a.y); }\u001b[29X\u001b[25;5H\u001b(B\u001b[m\u001b[33m\u001b[100minline\u001b(B\u001b[m\u001b[94m\u001b[100m num inv(num a) { dbl n = (a.x*a.x+a.y*a.y); \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m num(a.x/n,-a.y/n); }\u001b[26;5H\u001b(B\u001b[m\u001b[92m\u001b[100m/// end-hash\u001b[27;5H\u001b(B\u001b[m\u001b[91m\u001b[100m#else\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b[28;5H\u001b(B\u001b[m\u001b[92m\u001b[100m// NTT\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[27X\u001b[29;5H\u001b(B\u001b[m\u001b[33m\u001b[100mconst\u001b(B\u001b[m\u001b"]
