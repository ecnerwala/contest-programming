[667.772817, "o", "\u001b[?25l\u001b[41A\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b[29;9H»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[30;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[31;5H\u001b[60X\u001b[32;9H\u001b(B\u001b[m\u001b[92m\u001b[100m// Flip (1 mod 2, 1 mod 2) so that we need even # of 1's\u001b[33;9H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; i < N; i += \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m) {    \u001b[34;13H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m j = \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; j < M; j += \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m) {\u001b[35;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mG[\u001b(B\u001b[0;1m\u001b[31m\u001b[100m{\u001b(B\u001b[m\u001b[94m\u001b[100mi,j\u001b(B\u001b[0;1m\u001b[31m\u001b[100m}\u001b(B\u001b[m\u001b[94m\u001b[100m] ^= \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[36;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[37;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[38;5H\u001b[13X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m185 \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[K\r\u001b[28B\u001b(B\u001b[0;1m\u001b[97m\u001b[43m INSER"]
