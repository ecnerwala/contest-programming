[4392.372368, "o", "\u001b[m\u001b[94m\u001b[100m>> ch(N);\u001b[35;13H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; i < N; i++) {\u001b[36;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mch[par[i]].push_back(i); \u001b[37;13H}\u001b[27X\u001b[38;5H\u001b[9X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100mvector<\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m> sz(N);\u001b[40;13Hcerr << \u001b(B\u001b[m\u001b[36m\u001b[100m\"dfs\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[41;13Hstd::y_combinator([&](\u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m self, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m cur) -> \u001b(B\u001b[m\u001b[33m\u001b[100mvoid\u001b(B\u001b[m\u001b[94m\u001b[100m {\u001b[42;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100msz[cur] = \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[35X\u001b[43;17H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m nxt : ch[cur]) {\u001b[44;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcerr << cur << \u001b(B\u001b[m\u001b[36m\u001b[100m' '\u001b(B\u001b[m\u001b[94m\u001b[100m << nxt << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[45;21Hself(nxt);\u001b[24X\u001b[46;22Hz[cur] += sz[nxt];"]
[4392.372442, "o", "\u001b[47;17H}\u001b[22X\u001b[48;17Hsort(ch[cur].begin(), ch[cur].end(), [&](\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m a, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m b) { \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m sz[a] > sz[b]; });\u001b[49;13H})(\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[80X\u001b[50;5H\u001b[14X\n\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[33m\u001b[100mconst\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m PATH_TARGET = (N+\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m)/\u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[53;25HIRING_TARGET = PATH_TARGET + (PATH_TARGET % \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[54;13Hvector<\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m> path;\u001b[42X\u001b[55;27Hiring;\u001b[56;13H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m cur = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[8X\u001b[57;13Hassert(\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(path.size()) < PATH_TARGET);\u001b[58;26Hiring.size()) < PAIRING_TARGET);\u001b[59;13H\u001b(B\u001b[m\u001b[32m\u001b[100mwhile\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[36m\u001b[100mtrue\u001b(B\u001b[m\u001b[94m\u001b[100m) {\u001b[31X\u001b[60;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mpath.push_back(cur);\u001b[61;17H"]
[4392.3725, "o", "\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(path.size()) >= PATH_TARGET) {\u001b[62;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mbreak\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[28X\u001b[63;17H}\u001b[9X\u001b[64;17Hassert(!ch[cur].empty());\u001b[65;17H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m first_ch = ch[cur][\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m];\u001b[66;17H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m z = \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; z < \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(ch[cur].size()); z++) {\u001b[67;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mstd::y_combinator([&](\u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m self, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m a) -> \u001b(B\u001b[m\u001b[33m\u001b[100mvoid\u001b(B\u001b[m\u001b[94m\u001b[100m {\u001b[68;31H\u001b(B\u001b[m\u001b[96m\u001b[40m  2:yc.hpp  \u001b(B\u001b[0;1m\u001b[94m\u001b[100m 1:E.cpp+ \u001b(B\u001b[m\u001b[96m\u001b[40m                                            \u001b(B\u001b[m\u001b[30m\u001b[40m\u001b(B\u001b[m\u001b[92m\u001b[40m cpp \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[37m\u001b[103m utf-8[unix] \u001b(B\u001b[m\u001b[96m\u001b[103m\u001b(B\u001b[m\u001b[97m\u001b[106m 32% \u001b(B\u001b[0;1m\u001b[97m\u001b[106m☰ 40/123\u001b]2;E.cpp + ("]
