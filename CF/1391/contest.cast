[3971.896453, "o", "\u001b[?25l\u001b[36;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b[37;17H»   \u001b(B\u001b[m\u001b[94m\u001b[100m});\u001b[38;17H}\u001b[43X\u001b[39;17H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m cur_sz = \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(pairing.size()) + other_sz;\u001b[15X\u001b[40;17H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (cur_sz + min(sz[first_ch], cur_sz) >= PAIRING_TARGET) {\u001b[41;17H}\u001b[34X\u001b[42;41H+ other_sz)\u001b[9X\u001b[43;17H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(pairing.size()) >= PAIRING_TARGET) {\u001b[44;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mbreak\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[45;17H}\u001b[14X\u001b[46;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcur = first_ch;\u001b[47;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[48;5H\u001b[46X\u001b[49;13H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(path.size()) >= PATH_TARGET) {\u001b[50;25H\u001b(B\u001b[m\u001b[36m\u001b[100m\"PATH\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[5X\u001b[51;17Hcout << path.size() << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[16X\u001b[52;17H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b["]
[3971.896608, "o", "m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; i < \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(path.size()); i++) {\u001b[10X\u001b[53;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcout << path[i]+\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[36m\u001b[100m\" \u001b(B\u001b[m\u001b[31m\u001b[100m\\n\u001b(B\u001b[m\u001b[36m\u001b[100m\"\u001b(B\u001b[m\u001b[94m\u001b[100m[i+\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m==\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(path.size())];\u001b[54;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[46X\u001b[55;13H} \u001b(B\u001b[m\u001b[32m\u001b[100melse\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(pairing.size()) >= PAIRING_TARGET) {\u001b[56;25H\u001b(B\u001b[m\u001b[36m\u001b[100m\"PAIRING\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[14X\u001b[57;17Hcout << \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(pairing.size()) / \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[11X\u001b[58;17H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; i < \u001b(B\u001b[m\u001b[33m\u001b"]
