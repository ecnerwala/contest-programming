[4345.45458, "o", "\u001b[57;13Hassert(\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(path.size()) < PATH_TARGET);\u001b[58;26Hiring.size()) < PAIRING_TARGET);\u001b[59;13H\u001b(B\u001b[m\u001b[32m\u001b[100mwhile\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[36m\u001b[100mtrue\u001b(B\u001b[m\u001b[94m\u001b[100m) {\u001b[31X\u001b[60;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mpath.push_back(cur);\u001b[61;17H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(path.size()) >= PATH_TARGET) {\u001b[62;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mbreak\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[28X\u001b[63;17H}\u001b[9X\u001b[64;17Hassert(!ch[cur].empty());\u001b[65;17H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m first_ch = ch[cur][\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m];\u001b[66;17H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m z = \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; z < \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(ch[cur].size()); z++) {\u001b[67;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mstd::y_combinator([&](\u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m self, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m a) -> \u001b(B\u001b[m\u001b[33m\u001b[100mvoid\u001b(B\u001b[m\u001b[94m\u001b[100m {\u001b[68;1"]
