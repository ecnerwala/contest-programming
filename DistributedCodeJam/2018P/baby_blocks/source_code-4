#include "message.h"
#ifndef INPUT_HEADER
#define INPUT_HEADER "baby_blocks.h"
#endif
#include INPUT_HEADER
#include<bits/stdc++.h>
using namespace std;

typedef long long ll;

const int NODES = NumberOfNodes();
const int ID = MyNodeId();

const ll N = GetNumberOfBlocks();

const int MAXNODES = 200;
ll P[MAXNODES];
ll S[MAXNODES];

void phase1() {
	ll s = 0;
	for (ll i = P[ID]; i < P[ID+1]; i++) {
		s += GetBlockWeight(i);
	}
	for (int i = 0; i < NODES; i++) {
		PutLL(i, s);
		Send(i);
	}

	for (int z = 0; z < NODES; z++) {
		int i = Receive(-1);
		S[i+1] = GetLL(i);
	}

	for (int i = 0; i < NODES; i++) {
		S[i+1] += S[i];
	}
}

void phase2() {
	ll T = S[NODES];
	int jobs = 0;
	ll myres = 0;
	for (int i = 0; i < NODES; i++) {
		for (int j = i; j < NODES; j++) {
			if (S[i] + S[j] < T && S[i+1] + S[j+1] > T) {
				if ((jobs ++) % NODES == ID) {
					ll a = P[i+1];
					ll b = P[j];
					ll v = S[i+1] + S[j];
					while (a > P[i] && b < P[j+1]) {
						if (v == T) {
							if (a <= b) myres ++;
							v -= GetBlockWeight(--a);
							v += GetBlockWeight(b++);
						} else if (v > T) {
							v -= GetBlockWeight(--a);
						} else if (v < T) {
							v += GetBlockWeight(b++);
						} else assert(false);
					}
				}
			}
		}
	}
	PutLL(0, myres);
	Send(0);
	assert(jobs <= 3 * NODES);

	if (ID == 0) {
		ll res = 0;
		for (int z = 0; z < NODES; z++) {
			int i = Receive(-1);
			res += GetLL(i);
		}
		cout << res << '\n';
	}
}

int main() {
	for (int i = 0; i <= NODES; i++) {
		P[i] = (N / NODES) * ll(i) + min(N % NODES, ll(i));
	}

	phase1();

	phase2();

	return 0;
}
