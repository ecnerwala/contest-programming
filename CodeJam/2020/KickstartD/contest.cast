[360.441168, "o", "\u001b[?25l\u001b(B\u001b[0;7m\u001b[92m\u001b[100m#\u001b[2;5H \u001b[3;5Hint signum(int a) { return (a > 0) - (a < 0); }\u001b[4;5Hint compare(int a, int b) { return signum(a - b); }\u001b[5;5H \u001b[6;5Hint main() {\u001b[7;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100musing namespace std;\u001b[8;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mios_base::sync_with_stdio(false), cin.tie(nullptr);\u001b[9;5H \u001b[10;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mint T; cin >> T;\u001b[11;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mfor (int case_num = 1; case_num <= T; case_num ++) {\u001b[12;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mint N; cin >> N;\u001b[13;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mvector<int> A(N);\u001b[14;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mfor (int i = 0; i < N; i++) cin >> A[i];\u001b[15;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100marray<int, 4> dp{0,0,0,0};\u001b[16;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mfor (int i = 1; i < N; i++) {\u001b[17;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100marray<in"]
