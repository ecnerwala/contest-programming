[1448.613819, "o", "\u001b[?25l\u001b[16A\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b[42;5H»   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[43;5H\u001b[45X\u001b[44;21H\u001b(B\u001b[m\u001b[36m\u001b[100m\"Case #\"\u001b(B\u001b[m\u001b[94m\u001b[100m << case_num << \u001b(B\u001b[m\u001b[36m\u001b[100m\": \"\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[45;13Hcout << best_remove << \u001b(B\u001b[m\u001b[36m\u001b[100m' '\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[20X\u001b[46;13H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (ans == INF) cout << \u001b(B\u001b[m\u001b[36m\u001b[100m\"INDEFINITELY\"\u001b(B\u001b[m\u001b[94m\u001b[100m << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[47;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100melse\u001b(B\u001b[m\u001b[94m\u001b[100m cout << ans << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[48;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[49;5H\u001b[13X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[51;5H}\u001b[52;5H\u001b[25X\u001b[53;8H\u001b(B\u001b[m\u001b[92m\u001b[100mLet C = sum_chosen E_i\u001b(B\u001b[m\u001b[94m\u001b[100m  \u001b[54;8H\u001b(B\u001b[m\u001b[92m\u001b[100mBad toy is C < E_i + R_i\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[34X\u001b[55;8H\u001b(B\u001b[m\u001b[92m\u001b[100mCry time = first time you revisit a toy with C < E_i + R_i\r\n\u001b(B\u001b[0;1m\u001b[97m\u001b[43m INSERT \u001b(B\u001b[m\u001b[33m\u001b[103m\u001b(B\u001b[m\u001b[37m\u001b[103m +0 ~0 -0 "]
