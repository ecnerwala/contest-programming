[3919.971953, "o", "\u001b[?25l\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[20;38H \u001b[21;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b[22;9H\u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[31X\u001b[24;9Hvector<\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m> buf; buf.reserve(L);\u001b[26;9Hnum ans = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[20X\u001b[27;5H\u001b[28X\u001b[28;9H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = L-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; i >= \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; i--) {\u001b[21X\u001b[29;13H\u001b(B\u001b[m\u001b[92m\u001b[100m// sort the interval\u001b[30;17H\u001b(B\u001b[m\u001b[94m\u001b[100mheight = __builtin_clz(i) - __builtin_clz(L);\u001b[31;13Hassert(height >= \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[12X\u001b[32;13H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m lo = (i << height) - L;\u001b[33;13H\u001b(B\u001b[m\u001b[92m\u001b[100m// mergesort this range together\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[42X\u001b[34;13Hbuf.clear();\u001b[19X\u001b[35;13Hstd::y_combinator([&](\u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m self, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m l1, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m r1, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m l2, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m r2) -> \u001b"]
