[4321.529917, "o", "\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = L-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; i >= \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; i--) {\u001b[48;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// sort the interval\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[8X\u001b[49;13H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m height = __builtin_clz(i) - __builtin_clz(L);\u001b[50;13Hassert(height >= \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[29X\u001b[51;13H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m lo = (i << height) - L;\u001b[52;13H\u001b(B\u001b[m\u001b[92m\u001b[100m// mergesort this range together\u001b[53;13H\u001b(B\u001b[m\u001b[94m\u001b[100mbuf.clear();\u001b[20X\u001b[54;13Hstd::y_combinator([&](\u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m self, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m l1, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m r1, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m l2, \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m r2) -> \u001b(B\u001b[m\u001b[33m\u001b[100mvoid\u001b(B\u001b[m\u001b[94m\u001b[100m {\u001b[55;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100massert(l1 < r1 || l2 < r2);\u001b[43X\u001b[56;17H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (r1 - l1 == \u001b(B\u001b[m\u001b[36m\u001b[100m0"]
[4321.530088, "o", "\u001b(B\u001b[m\u001b[94m\u001b[100m || r2 - l2 == \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m) {\u001b[57;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// just handle both, one of these will be empty\u001b[58;21H\u001b(B\u001b[m\u001b[94m\u001b[100mbuf.insert(buf.end(), P.begin()+l1, P.begin()+r1);\u001b[59;54H2, P.begin()+r2\u001b[60;21H\u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[43X\u001b[61;17H}\u001b[10X\u001b[62;17Hassert(l1 < r1 && l2 < r2);\u001b[63;17H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[4:3m\u001b[58:2::255:0:0m\u001b[94m\u001b[100mmi\u001b(B\u001b[m\u001b[94m\u001b[100m = \u001b(B\u001b[m\u001b[4:3m\u001b[58:2::0:0:255m\u001b[94m\u001b[100mmin\u001b(B\u001b[m\u001b[94m\u001b[100m(P[l1], P[l2]\u001b[64;22H\u001b(B\u001b[m\u001b[4:3m\u001b[58:2::255:0:0m\u001b[94m\u001b[100ma\u001b(B\u001b[m\u001b[94m\u001b[100m = max(P[r1-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m], P[r2-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m]);\u001b[65;17Hassert(mi < ma);\u001b[15X\u001b[66;17H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m h = \u001b(B\u001b[m\u001b[36m\u001b[100m32\u001b(B\u001b[m\u001b[94m\u001b[100m - __builtin_clz(mi ^ ma);\u001b[67;17Hassert(h >= \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[21X\u001b[68;130H\u001b(B\u001b[0;1m\u001b[97m\u001b[106m7 \u001b(B\u001b[m\u001b[97m\u001b[106m:5\u001b[33;9H\u001b[?25h"]
