[4229.026811, "o", "adj[v].push_back(e);\u001b[16;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m}\u001b[17;5H \u001b[18;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m// it's the last edge you took and the time you're there\u001b[19;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mconst int INF = 1e9;\u001b[20;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mtensor<int, 2> best_val({T+1, N+M*2}, -INF);\u001b[21;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mbest_val[\u001b(B\u001b[0;1;7m\u001b[92m\u001b[100m{\u001b(B\u001b[0;7m\u001b[92m\u001b[100m0, 2*M+0\u001b(B\u001b[0;1;7m\u001b[92m\u001b[100m}\u001b(B\u001b[0;7m\u001b[92m\u001b[100m] = 0;\u001b[22;5H \u001b[23;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mint ans = -INF;\u001b[24;5H \u001b[25;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mfor (int t = 0; t <= T; t++) {\u001b[26;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mfor (int x = 0; x < N+M*2; x++) {\u001b[27;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mif (best_val[\u001b(B\u001b[0;1;7m\u001b[92m\u001b[100m{\u001b(B\u001b[0;7m\u001b[92m\u001b[100mt, x\u001b(B\u001b[0;1;7m\u001b[92m\u001b[100m}\u001b(B\u001b[0;7m\u001b[92m\u001b[100m] == -INF) continue;\u001b[28;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b"]
[4229.027128, "o", "[0;7m\u001b[92m\u001b[100mint v;\u001b[29;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mif (x < 2*M) {\u001b[30;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mv = edges[x / 2].v[x % 2];\u001b[31;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m} else {\u001b[32;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mv = x - (2*M);\u001b[33;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m}\u001b[34;5H \u001b[35;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m//cerr << t << ' ' << v << ' ' << x << ' ' << best_val[{t, x}] << '\\n';\u001b[36;5H \u001b[37;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mif (v == N-1) setmax(ans, best_val[\u001b(B\u001b[0;1;7m\u001b[92m\u001b[100m{\u001b(B\u001b[0;7m\u001b[92m\u001b[100mt, x\u001b(B\u001b[0;1;7m\u001b[92m\u001b[100m}\u001b(B\u001b[0;7m\u001b[92m\u001b[100m]);\u001b[38;5H \u001b[39;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mfor (int e : adj[v]) {\u001b[40;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mint u_dir = edges[e].v[1] != v;\u001b[41;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mint"]
