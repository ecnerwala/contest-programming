[3909.506487, "o", "dges[e].v[u_dir];\u001b[56;5H\u001b[43X\u001b[57;21H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m cnd = best_val[\u001b(B\u001b[0;1m\u001b[31m\u001b[100m{\u001b(B\u001b[m\u001b[94m\u001b[100mt, x\u001b(B\u001b[0;1m\u001b[31m\u001b[100m}\u001b(B\u001b[m\u001b[94m\u001b[100m]; \u001b[58;21H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (x < \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m*M && e == x / \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m) {\u001b[18X\u001b[59;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// then tracing it back isn't worth bounty\u001b[60;21H\u001b(B\u001b[m\u001b[94m\u001b[100m} \u001b(B\u001b[m\u001b[32m\u001b[100melse\u001b(B\u001b[m\u001b[94m\u001b[100m {\u001b[8X\u001b[61;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcnd += D[u];\u001b[62;21H}\u001b[43X\u001b[63;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100msetmax(best_val[\u001b(B\u001b[0;1m\u001b[31m\u001b[100m{\u001b(B\u001b[m\u001b[94m\u001b[100mt + edges[e].r, nx\u001b(B\u001b[0;1m\u001b[31m\u001b[100m}\u001b(B\u001b[m\u001b[94m\u001b[100m], cnd);\u001b[64;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[65;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[66;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[67;5H\u001b[13X\r\n\u001b(B\u001b[0;1m\u001b[97m\u001b[43m INSERT \u001b(B\u001b[m\u001b[33m\u001b[103m\u001b(B\u001b[m\u001b[37m\u001b[103m +0 ~0 -0  masterɆ \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[96m\u001b[40m  2:tensor.hpp"]
