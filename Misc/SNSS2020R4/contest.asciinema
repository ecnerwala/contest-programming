[4035.887546, "o", "»   \u001b(B\u001b[m\u001b[94m\u001b[100mv = x - (\u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m*M);\u001b[40;17H}\u001b[17X\u001b[41;5H\u001b[13X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcerr << t << \u001b(B\u001b[m\u001b[36m\u001b[100m' '\u001b(B\u001b[m\u001b[94m\u001b[100m << v << \u001b(B\u001b[m\u001b[36m\u001b[100m' '\u001b(B\u001b[m\u001b[94m\u001b[100m << x << \u001b(B\u001b[m\u001b[36m\u001b[100m' '\u001b(B\u001b[m\u001b[94m\u001b[100m << best_val[\u001b(B\u001b[0;1m\u001b[31m\u001b[100m{\u001b(B\u001b[m\u001b[94m\u001b[100mt, x\u001b(B\u001b[0;1m\u001b[31m\u001b[100m}\u001b(B\u001b[m\u001b[94m\u001b[100m] << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[43;5H\u001b[81X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (v == N-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m) setmax(ans, best_val[\u001b(B\u001b[0;1m\u001b[31m\u001b[100m{\u001b(B\u001b[m\u001b[94m\u001b[100mt, x\u001b(B\u001b[0;1m\u001b[31m\u001b[100m}\u001b(B\u001b[m\u001b[94m\u001b[100m]);\u001b[45;5H\u001b[56X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m e : adj[v]) {\u001b[47;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m u_dir = edges[e].v[\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m] != v;\u001b[48;25Hnx = e * \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m + u_dir;\u001b[8X\u001b[49;25Hu = edges[e].v[u_dir"]
[4035.887671, "o", "];\u001b[50;25Hnt = t + edges[e].r;  \u001b[51;5H\u001b[40X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m cnd = best_val[\u001b(B\u001b[0;1m\u001b[31m\u001b[100m{\u001b(B\u001b[m\u001b[94m\u001b[100mt, x\u001b(B\u001b[0;1m\u001b[31m\u001b[100m}\u001b(B\u001b[m\u001b[94m\u001b[100m];\u001b[53;21H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (x < \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m*M && e == x / \u001b(B\u001b[m\u001b[36m\u001b[100m2\u001b(B\u001b[m\u001b[94m\u001b[100m) {\u001b[54;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[92m\u001b[100m// then tracing it back isn't worth bounty\u001b[55;21H\u001b(B\u001b[m\u001b[94m\u001b[100m} \u001b(B\u001b[m\u001b[32m\u001b[100melse\u001b(B\u001b[m\u001b[94m\u001b[100m {\u001b[38X\u001b[56;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcnd += D[u];\u001b[57;21H}\u001b[15X\u001b[58;5H\u001b[17X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (nt <= T) setmax(best_val[\u001b(B\u001b[0;1m\u001b[31m\u001b[100m{\u001b(B\u001b[m\u001b[94m\u001b[100mnt, nx\u001b(B\u001b[0;1m\u001b[31m\u001b[100m}\u001b(B\u001b[m\u001b[94m\u001b[100m], cnd);\u001b[60;17H}\u001b[48X\u001b[61;13H}    \u001b[62;9H}    \u001b[63;5H\u001b[5X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcout << ans << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[65;5H\u001b[24X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b"]
