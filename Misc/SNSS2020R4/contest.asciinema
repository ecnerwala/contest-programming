[2589.909689, "o", "\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m check_m = [&](\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m m) {\u001b[12;2H\u001b(B\u001b[m\u001b[92m\u001b[40m49 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (cur_closers[m] == num_closers[m]) {\u001b[13;2H\u001b(B\u001b[m\u001b[92m\u001b[40m50 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// we can actually use this switch\u001b[14;2H\u001b(B\u001b[m\u001b[92m\u001b[40m51 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mauto\u001b(B\u001b[m\u001b[94m\u001b[100m [b, _] : switch_boxes[m]) {\u001b[15;2H\u001b(B\u001b[m\u001b[92m\u001b[40m52 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (!is_opened[b]) {\u001b[16;2H\u001b(B\u001b[m\u001b[92m\u001b[40m53 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mis_opened[b] = \u001b(B\u001b[m\u001b[36m\u001b[100mtrue\u001b(B\u001b[m\u001b[94m\u001b[100m; \u001b[17;2H\u001b(B\u001b[m\u001b[92m\u001b[40m54 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mq.push_back(b);\u001b[18;2H\u001b(B\u001b[m\u001b[92m\u001b[40m55 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »  "]
