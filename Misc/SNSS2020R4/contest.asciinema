[2274.921274, "o", "\u001b[?25l\u001b[34;17H\u001b[48X\nfill(is_opened.begin(), is_opened.end(), \u001b(B\u001b[m\u001b[36m\u001b[100mfalse\u001b(B\u001b[m\u001b[94m\u001b[100m);\u001b[36;17H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = lo; i < hi; i++) {\u001b[37;21His_opened[i] = \u001b(B\u001b[m\u001b[36m\u001b[100mtrue\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[38;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mq.push_back(i);\u001b[39;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[40;5H\u001b[53X\u001b[41;17H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m z = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; z < \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(q.size()); z++) {\u001b[42;21H\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m cur = q[z];\u001b[13X\u001b[43;21H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m m : closers[cur]) {\u001b[7X\u001b[44;25H\u001b(B\u001b[m\u001b[92m\u001b[100m// now these guys are more free\u001b[45;25H\u001b(B\u001b[m\u001b[94m\u001b[100mcur_closers[m]++;\u001b[22X\u001b[46;25H\u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (cur_closers[m] == num_closers[m]) {\u001b[47;29H\u001b(B\u001b[m\u001b[92m\u001b[100m// we can actually use this switch\u001b(B\u001b[m\u001b[94m\u001b[100m "]
