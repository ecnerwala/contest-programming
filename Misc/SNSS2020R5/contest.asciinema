[1032.814806, "o", "\u001b(B\u001b[m\u001b[94m\u001b[100m (T--) {\u001b[31X\u001b[23;13H\u001b(B\u001b[m\u001b[33m\u001b[100mint64_t\u001b(B\u001b[m\u001b[94m\u001b[100m L, R; \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m K; cin >> L >> R >> K;    \u001b[24;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcout << solve(R+\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m, K) - solve(L, K) << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[25;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[26;5H\u001b[13X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m 28 \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[K\r\u001b[40B\u001b(B\u001b[0;1m\u001b[97m\u001b[43m INSERT \u001b(B\u001b[m\u001b[33m\u001b[103m\u001b(B\u001b[m\u001b[37m\u001b[103m +0 ~0 -0  masterɆ \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[96m\u001b[40m \u001b(B\u001b[0;1m\u001b[94m\u001b[100m 1:B.cpp+ \u001b(B\u001b[m\u001b[96m\u001b[40m                                                         \u001b(B\u001b[m\u001b[30m\u001b[40m\u001b(B\u001b[m\u001b[92m\u001b[40m cpp \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[37m\u001b[103m utf-8[unix] \u001b(B\u001b[m\u001b[33m\u001b[103m\u001b(B\u001b[m\u001b[97m\u001b[43m 28% \u001b(B\u001b[0;1m\u001b[97m\u001b[43m☰ 8/28 \u001b(B\u001b[m\u001b[97m\u001b[43m:5 \u001b(B\u001b[m\u001b[91m\u001b[43m\u001b]2;B.cpp + (~/Dropbox/programming/Misc/SNSS2020R5/B) - NVIM\u0007\u001b[69;13H\u001b[?25"]
