[4638.267479, "o", "\u001b[?25l\u001b[46;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[47;5H\u001b[45X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// choose[j] = (j+m choose m)\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[49;5H\u001b[52X\u001b[50;21H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; i + m*c <= N; i++) {\u001b[39X\u001b[51;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mndp[i+m*c] += choose[i/c] * suff_val[i] * pref_val[i+m*c] * prods[i/c];\u001b[52;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[53;17H}\u001b[13X\u001b[54;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mswap(dp, ndp);\u001b[55;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[56;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[57;5H\u001b[26X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcout << dp[N] << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[59;5H\u001b[13X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[61;5H}\u001b[62;5H\u001b[100X\u001b[63;8H\u001b(B\u001b[m\u001b[92m\u001b[100m# of things with cycle structure [c_0 * m_0, c_1 * m1,"]
