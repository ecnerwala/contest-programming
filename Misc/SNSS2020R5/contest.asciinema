[5463.191317, "i", "\u001b[200~typedef long long ll;\rtypedef unsigned long long ull;\rtypedef __uint128_t L;\r\rstruct Barrett {\r\tull d, m;\r\tBarrett(ull d) : d(d), m(ull((L(1) << 64) / d)) {}\r\r\tull reduce(ull a) {\r\t\tull q = (ull)((L(m) * a) >> 64);\r\t\tull r = a - q * d;\r\t\tif (r >= d) r -= d;\r\t\treturn r;\r\t}\r};\r\u001b[201~"]
