[4186.179121, "o", "\u001b[?25l\u001b[23;17H\u001b[14X\nchoose[\u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m] = \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[18X\u001b[25;17H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m m = \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; c*m <= N; m++) {\u001b[26;21Hchoose.pop_back();\u001b[52X\u001b[27;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m v = \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; v < \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(choose.size()); v++) choose[v] += choose[v-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m];\u001b[28;5H\u001b[45X\u001b[29;21H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; i < N; i++) {\u001b[30;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[31;17H}\u001b[13X\u001b[32;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mswap(dp, ndp);\u001b[33;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[34;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[35;5H\u001b[26X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcout << dp[N] << \u001b(B\u001b["]
[4186.179271, "o", "m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[37;5H\u001b[13X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[39;5H}\u001b[40;5H\u001b[100X\u001b[41;8H\u001b(B\u001b[m\u001b[92m\u001b[100m# of things with cycle structure [c_0 * m_0, c_1 * m1, ...] is exactly N! / prod (c_i^m_i * m_i!)\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m122 \u001b(B\u001b[m\u001b[92m\u001b[100m// why is this so hard without division :(\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\u001b[26B\u001b(B\u001b[0;1m\u001b[97m\u001b[43m INSERT \u001b(B\u001b[m\u001b[33m\u001b[103m\u001b(B\u001b[m\u001b[37m\u001b[103m +0 ~0 -0  masterɆ \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[96m\u001b[40m  2:modnum.hpp  \u001b(B\u001b[0;1m\u001b[94m\u001b[100m 1:C.cpp+ \u001b(B\u001b[m\u001b[96m\u001b[40m                                      \u001b(B\u001b[m\u001b[30m\u001b[40m\u001b(B\u001b[m\u001b[92m\u001b[40m cpp \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[37m\u001b[103m utf-8[unix] \u001b(B\u001b[m\u001b[33m\u001b[103m\u001b(B\u001b[m\u001b[97m\u001b[43m 84% \u001b(B\u001b[0;1m\u001b[97m\u001b[43m☰ 103/122 \u001b(B\u001b[m\u001b[97m\u001b[43m:13 \u001b(B\u001b[m\u001b[91m\u001b[43m\u001b]2;C.cpp + (~/Dropbox/programming/Misc/SNSS2020R5/C) - NVIM\u0007\u001b[69;13H\u001b[?25h\u001b[?25l\u001b[23;17H\u001b[?25h"]
