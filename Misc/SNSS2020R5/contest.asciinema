[4504.073442, "o", "\u001b[?25l\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[41;17H\u001b[32X\n\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m m = \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; c*m <= N; m++) {\u001b[43;21Hchoose.pop_back();\u001b[52X\u001b[44;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m v = \u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m; v < \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(choose.size()); v++) choose[v] += choose[v-\u001b(B\u001b[m\u001b[36m\u001b[100m1\u001b(B\u001b[m\u001b[94m\u001b[100m];\u001b[45;5H\u001b[45X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// choose[j] = (j+m choose m)\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[47;5H\u001b[52X\u001b[48;21H\u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; i + m*c <= N; i\u001b(B\u001b[m\u001b[4:3m\u001b[58:2::255:0:0m\u001b[94m\u001b[100m+\u001b(B\u001b[m\u001b[94m\u001b[100m+) {    \u001b[49;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mndp[i+m*c] += choose[i/c] * [i+m*c];\u001b[50;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[51;17H}\u001b[13X\u001b[52;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m"]
[4504.073736, "o", "swap(dp, ndp);\u001b[53;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[54;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[55;5H\u001b[26X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcout << dp[N] << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[57;5H\u001b[13X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[59;5H}\u001b[60;5H\u001b[100X\u001b[61;8H\u001b(B\u001b[m\u001b[92m\u001b[100m# of things with cycle structure [c_0 * m_0, c_1 * m1, ...] is exactly N! / prod (c_i^m_i * m_i!)\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m142 \u001b(B\u001b[m\u001b[92m\u001b[100m// why is this so hard without division :(\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\u001b[6B\u001b(B\u001b[0;1m\u001b[97m\u001b[43m INSERT \u001b(B\u001b[m\u001b[33m\u001b[103m\u001b(B\u001b[m\u001b[37m\u001b[103m +0 ~0 -0  masterɆ \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[96m\u001b[40m  2:modnum.hpp  \u001b(B\u001b[0;1m\u001b[94m\u001b[100m 1:C.cpp+ \u001b(B\u001b[m\u001b[96m\u001b[40m                                      \u001b(B\u001b[m\u001b[30m\u001b[40m\u001b(B\u001b[m\u001b[92m\u001b[40m cpp \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[37m\u001b[103m utf-8[unix] \u001b(B\u001b[m\u001b[33m\u001b[103m\u001b(B\u001b[m\u001b[97m\u001b[43m 85% \u001b(B\u001b[0;1m\u001b[97m\u001b[43m☰ 121/142 \u001b(B\u001b[m\u001b[97m\u001b[43m:13 \u001b(B\u001b[m\u001b[91m\u001b[43m\u001b]2;C.cpp +"]
