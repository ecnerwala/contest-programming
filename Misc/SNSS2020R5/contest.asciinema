[5178.089434, "o", "\u001b[?25l\r\u001b[31A\u001b(B\u001b[m\u001b[92m\u001b[40m127 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                    \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m128 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[92m\u001b[100m// choose[j] = (j+m choose m)\u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                       \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m129 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m i = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; i + m*c <= N; i++) {                                                                                \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m130 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mndp[i+m\u001b(B\u001b[m\u001b[4:3m\u001b[58:2::255:0:0m\u001b[94m\u001b[100m*c] +\u001b(B\u001b[m\u001b[94m\u001b[100m= dp[i] * choose[i/c] * suff_val[i] * pref_val[i+m*c] * prods[i/c];                                 \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m131 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}                   "]
[5178.089636, "o", "                                                                                                \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m132 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                    \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m133 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m v = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; v < \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(prods.size()); v++) prods[v] *= suff_val[(v+m) * c];                                        \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m134 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}                                                                                                                       \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m135 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mswap(dp, ndp);                                                                                                          \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m136 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   \u001b(B"]
