[5160.562903, "o", "m; x <= i+m*c; x++) {                                                                            \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m136 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mif\u001b(B\u001b[m\u001b[94m\u001b[100m (x % c == \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m) \u001b(B\u001b[m\u001b[32m\u001b[100mcontinue\u001b(B\u001b[m\u001b[94m\u001b[100m;                                                                                   \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m137 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mcoeff *= num(x);                                                                                            \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m138 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}                                                                                                               \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m139 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100massert(coeff == suff_val[i] * pref_val[i+m*c] * prods[i/c]);                                                    \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m140 \u001b(B\u001b[m\u001b[94m\u001b[100m                 "]
[5160.562924, "o", "                                                                                                                   \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m141 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100mndp[i+m*c] += dp[i] * choose[i/c] * suff_val[i] * pref_val[i+m*c] * prods[i/c];                                 \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m142 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}                                                                                                                   \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m143 \u001b(B\u001b[m\u001b[94m\u001b[100m                                                                                                                                    \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m144 \u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   »   \u001b(B\u001b[m\u001b[32m\u001b[100mfor\u001b(B\u001b[m\u001b[94m\u001b[100m (\u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m v = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; v < \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(prods.size()); v++) prods[v] *= suff_val[(v+m) * c];                                        \r\n\u001b(B\u001b[m\u001b[92m\u001b[40m145 \u001b(B\u001b[0;1m\u001b["]
