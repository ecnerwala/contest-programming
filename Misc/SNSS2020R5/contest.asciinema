[5206.015294, "o", "[m\u001b[94m\u001b[100m v = \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m; v < \u001b(B\u001b[m\u001b[33m\u001b[100mint\u001b(B\u001b[m\u001b[94m\u001b[100m(prods.size()); v++) prods[v] *= suff_val[(v+m) * c];\u001b[55;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   »   »   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[56;5H\u001b[26X\u001b[57;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mswap(dp, ndp);\u001b[58;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[59;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100m}\u001b[60;5H\u001b[26X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[94m\u001b[100mcout << dp[N] << \u001b(B\u001b[m\u001b[31m\u001b[100m'\\n'\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[62;5H\u001b[13X\n\u001b(B\u001b[0;1m\u001b[30m\u001b[100m»   \u001b(B\u001b[m\u001b[32m\u001b[100mreturn\u001b(B\u001b[m\u001b[94m\u001b[100m \u001b(B\u001b[m\u001b[36m\u001b[100m0\u001b(B\u001b[m\u001b[94m\u001b[100m;\u001b[64;5H}\u001b[65;5H\u001b[100X\u001b[66;8H\u001b(B\u001b[m\u001b[92m\u001b[100m# of things with cycle structure [c_0 * m_0, c_1 * m1, ...] is exactly N! / prod (c_i^m_i * m_i!)\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m147 \u001b(B\u001b[m\u001b[92m\u001b[100m// why is this so hard without division :(\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[0;1m\u001b[97m\u001b[43m INSERT \u001b(B\u001b[m\u001b[33m\u001b[103m\u001b(B\u001b[m\u001b[37m\u001b[103m +0 ~0 -0  masterɆ \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[96m\u001b[40m  2:modnum.hpp  \u001b(B\u001b[0;1m\u001b[94m\u001b[100m 1:C.cpp+ "]
