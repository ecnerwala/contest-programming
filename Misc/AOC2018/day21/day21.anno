#ip 5
0: seti 123 0 4 # r[4] = 123
1: bani 4 456 4 # r[4] &= 456
2: eqri 4 72 4 # r[4] == 72
3: addr 4 5 5 # if r[4]: jump to 5
4: seti 0 0 5 # else: jump to 0 (infinte loop)

5: seti 0 8 4 # r[4] = 0

6: bori 4 65536 3 # r[3] = r[4] | 65536
7: seti 707129 0 4 # r[4] = 707129 = 0xACA39

8: bani 3 255 2 # r[2] = r[3] & 255
9: addr 4 2 4 # r[4] += r[3] & 255
10: bani 4 16777215 4 # r[4] &= (1<<24)-1
11: muli 4 65899 4 # r[4] *= 65899
12: bani 4 16777215 4 # r[4] &= (1<<24)-1
13: gtir 256 3 2 # r[2] = (256 > r[3])
14: addr 2 5 5 # if 256 > r[3]: jump to 16
15: addi 5 1 5 # else: jump to 17
16: seti 27 6 5 # jump to 28

17: seti 0 7 2 # r[2] = 0

18: addi 2 1 1 # r[1] = r[2] + 1
19: muli 1 256 1 # r[1] *= 256
20: gtrr 1 3 1 # r[1] = (r[1] > r[3])
21: addr 1 5 5 # if r[1] > r[3]: jump to 23
22: addi 5 1 5 # jump to 24
23: seti 25 2 5 # jump to 26
24: addi 2 1 2 # r[2] += 1
25: seti 17 1 5 # jump to 18

26: setr 2 4 3 # r[3] = r[2]
27: seti 7 4 5 # jump to 8

28: eqrr 4 0 2 # r[2] = (r[4] == r[0])
29: addr 2 5 5 # if r[4] == r[0]: halt
30: seti 5 2 5 # else: jump to 6 

r[4] = 0

while (true) {
    r[3] = r[4] | 65536
    r[4] = 0xACA39

    while (true) {
        r[4] += r[3] % 256
        r[4] *= 65899
        r[4] %= (1<<24)

        if r[3] < 256: break

        r[3] = r[3] // 256
    }

    if r[4] == r[0]: halt
}
