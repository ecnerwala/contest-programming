[1658.609179, "o", "\u001b[?25l\u001b[1;67r\u001b[H\u001b[33M\u001b[r\u001b[13;9H\u001b(B\u001b[0;7m\u001b[92m\u001b[100mo\u001b[14;5H// Doubles b as b[:n] = (2 - a[:n] * b[:n/2]) * b[:n/2]\u001b[15;5Hvn inverse(const vn& a) { /// start-hash\u001b[16;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mif (a.empty()) return {};\u001b[17;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mvn b({inv(a[0])});\u001b[18;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mb.reserve(2*a.size());\u001b[19;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mwhile (sz(b) < sz(a)) {\u001b[20;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mint n = 2*sz(b);\u001b[21;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mb.resize(2*n, 0);\u001b[22;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mif (sz(fa) < 2*n) fa.resize(2*n);\u001b[23;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mfill(fa.begin(), fa.begin()+2*n, 0);\u001b[24;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mcopy(a.begin(), a.begin()+min(n,sz(a)), fa.begin());\u001b[25;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mfft(b, 2*n);\u001b[26;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   "]
[1658.609225, "o", "\u001b(B\u001b[0;7m\u001b[92m\u001b[100mfft(fa, 2*n);\u001b[27;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mnum d = inv(num(2*n));\u001b[28;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mrep(i, 0, 2*n) b[i] = b[i] * (2 - fa[i] * b[i]) * d;\u001b[29;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mreverse(b.begin()+1, b.end());\u001b[30;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mfft(b, 2*n);\u001b[31;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mb.resize(n);\u001b[32;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m}\u001b[33;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mb.resize(a.size());\u001b[34;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mreturn b;\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m101 \u001b(B\u001b[0;7m\u001b[92m\u001b[100m} /// end-hash\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m102 \u001b(B\u001b[0;7m\u001b[92m\u001b[100m \u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m103 \u001b(B\u001b[0;7m\u001b[92m\u001b[100m#if FFT\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m104 \u001b(B\u001b[0;7m\u001b[92m\u001b[100m// Double multiply (num = complex)\u001b(B\u001b[m\u001b[94m\u001b[100m\u001b[K\r\n\u001b(B\u001b[m\u001b[92m\u001b[40m105 \u001b(B\u001b[0;7m\u001b[92m\u001b[100musing vd = vector<double>;\u001b(B\u001b["]
