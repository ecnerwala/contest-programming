[400.424055, "o", "\u001b[?25l\u001b(B\u001b[0;7m\u001b[92m\u001b[100m#\u001b[2;5H \u001b[3;5Hint main() {\u001b[4;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100musing namespace std;\u001b[5;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mios_base::sync_with_stdio(false), cin.tie(nullptr);\u001b[6;5H \u001b[7;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mint64_t n5, n4, n3, n2, n1; cin >> n5 >> n4 >> n3 >> n2 >> n1;\u001b[8;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mint64_t ans = 0;\u001b[9;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mans += n5; n5 = 0;\u001b[10;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mans += n4; n1 -= min(n4, n1); n4 = 0;\u001b[11;5H \u001b[12;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mans += n3;\u001b[13;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m// as many 2's as possible\u001b[14;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m{\u001b[15;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mint64_t v = min(n3, n2);\u001b[16;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mn2 -= v;\u001b[17;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mn3 -= v;\u001b[18;5H \u001b[19;5H\u001b(B"]
[400.424235, "o", "\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mn1 -= min(n1, n3 * 2);\u001b[20;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   »   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mn3 = 0;\u001b[21;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m}\u001b[22;5H \u001b[23;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100m// we have just 2's and 1's\u001b[24;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mans += max((n2 + 1) / 2, (n2 * 2 + n1 + 4) / 5);\u001b[25;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mcout << ans << '\\n';\u001b[26;5H \u001b[27;5H\u001b(B\u001b[0;1;7m\u001b[30m\u001b[100m»   \u001b(B\u001b[0;7m\u001b[92m\u001b[100mreturn 0;\u001b[28;5H\u001b(B\u001b[0;1m\u001b[31m\u001b[102m}\u001b[68;97H\u001b(B\u001b[m\u001b[30m\u001b[40m\u001b(B\u001b[m\u001b[92m\u001b[40m cpp \u001b(B\u001b[m\u001b[93m\u001b[40m\u001b(B\u001b[m\u001b[37m\u001b[103m utf-8[unix] \u001b(B\u001b[m\u001b[35m\u001b[103m\u001b(B\u001b[m\u001b[97m\u001b[45m 100% \u001b(B\u001b[0;1m\u001b[97m\u001b[45m☰ 28\u001b[28;5H\u001b[?25h"]
